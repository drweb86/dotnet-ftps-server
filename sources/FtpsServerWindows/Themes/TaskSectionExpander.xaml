<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="TaskSectionBackground" Color="#2B2A31"/>
    <SolidColorBrush x:Key="TaskSectionHeaderBackground" Color="#35343C"/>
    <SolidColorBrush x:Key="TaskSectionHeaderPointerOverBackground" Color="#3C3B44"/>
    <SolidColorBrush x:Key="TaskSectionBorderBrush" Color="#45444D"/>
    <SolidColorBrush x:Key="TaskSectionChevronBrush" Color="#F3F4F6"/>

    <Style x:Key="SectionExpanderHeader" TargetType="ToggleButton">
        <Setter Property="Background" Value="{StaticResource TaskSectionHeaderBackground}"/>
        <Setter Property="Foreground" Value="{StaticResource TaskSectionChevronBrush}"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="HeaderRoot"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path x:Name="ExpandCollapseChevron"
                                  Grid.Column="0"
                                  Margin="0,0,8,0"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="M 0,0 L 7,7 L 14,0"
                                  Stroke="{StaticResource TaskSectionChevronBrush}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="-90"/>
                                </Path.RenderTransform>
                            </Path>
                            <ContentPresenter Grid.Column="1"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HeaderRoot" Property="Background" Value="{StaticResource TaskSectionHeaderPointerOverBackground}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="HeaderRoot" Property="CornerRadius" Value="6,6,0,0"/>
                            <Setter TargetName="ExpandCollapseChevron" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="0"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ConnectionInstructionExpanderHeader" TargetType="ToggleButton" BasedOn="{StaticResource SectionExpanderHeader}">
        <Setter Property="Padding" Value="16,12"/>
    </Style>

    <Style x:Key="SectionExpander" TargetType="Expander">
        <Setter Property="Background" Value="{StaticResource TaskSectionBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource TaskSectionBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource TaskSectionChevronBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                        <DockPanel LastChildFill="True">
                            <ToggleButton x:Name="HeaderSite"
                                          DockPanel.Dock="Top"
                                          Style="{StaticResource SectionExpanderHeader}"
                                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Content="{TemplateBinding Header}"
                                          ContentTemplate="{TemplateBinding HeaderTemplate}"
                                          Foreground="{StaticResource TaskSectionChevronBrush}"/>
                            <Border x:Name="HeaderSeparator"
                                    DockPanel.Dock="Top"
                                    Height="1"
                                    Background="{TemplateBinding BorderBrush}"
                                    Visibility="Collapsed"/>
                            <ContentPresenter x:Name="ExpandSite"
                                              Margin="12,4,12,12"
                                              Visibility="Collapsed"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"/>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="HeaderSeparator" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ConnectionInstructionExpander" TargetType="Expander" BasedOn="{StaticResource SectionExpander}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                        <DockPanel LastChildFill="True">
                            <ToggleButton x:Name="HeaderSite"
                                          DockPanel.Dock="Top"
                                          Style="{StaticResource ConnectionInstructionExpanderHeader}"
                                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Content="{TemplateBinding Header}"
                                          ContentTemplate="{TemplateBinding HeaderTemplate}"
                                          Foreground="{StaticResource TaskSectionChevronBrush}"/>
                            <Border x:Name="HeaderSeparator"
                                    DockPanel.Dock="Top"
                                    Height="1"
                                    Background="{TemplateBinding BorderBrush}"
                                    Visibility="Collapsed"/>
                            <ContentPresenter x:Name="ExpandSite"
                                              Margin="12,4,12,12"
                                              Visibility="Collapsed"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"/>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="HeaderSeparator" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
