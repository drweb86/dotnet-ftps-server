<Window x:Class="FtpsServerWindows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FtpsServerWindows"
        xmlns:controls="clr-namespace:FtpsServerWindows.Controls"
        xmlns:res="clr-namespace:FtpsServerWindows.Resources"
        Title="{x:Static res:Strings.AppTitle}"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource WindowForegroundBrush}"
        MinWidth="720"
        ResizeMode="CanResize">

    <Grid>
        <controls:ViewDecoration />
        <DockPanel Margin="0">
            <local:MainMenuControl x:Name="MainMenu"
                                   DockPanel.Dock="Top"
                                   VerticalAlignment="Center"
                                   StartStopClicked="MainMenu_StartStopClicked" />
            <controls:UpdateCheckExpanderView DockPanel.Dock="Top" />

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Style="{StaticResource FormContent}">
                <controls:MessageBar x:Name="ValidationBar" Kind="Error" />

                <Button x:Name="StartStopButton"
                        Style="{StaticResource SecondaryButton}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        MinHeight="48"
                        Margin="0,0,0,8"
                        Click="MainMenu_StartStopClicked">
                    <TextBlock x:Name="StartStopButtonText"
                               Text="{x:Static res:Strings.MenuStart}"
                               Foreground="Green"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </Button>

                <Expander x:Name="ConnectionInstructionExpander"
                          Style="{StaticResource ConnectionInstructionExpander}"
                          IsExpanded="True"
                          Visibility="Collapsed">
                    <Expander.Header>
                        <controls:ExpanderHeader Icon="📋" Text="{x:Static res:Strings.ConnectionInstructionTitle}" />
                    </Expander.Header>
                    <controls:ConnectionInstructionControl x:Name="ConnectionInstruction" />
                </Expander>

                <Expander x:Name="ConfigExpander" Style="{StaticResource SectionExpander}" IsExpanded="True">
                    <Expander.Header>
                        <controls:ExpanderHeader Icon="🔒" Text="{x:Static res:Strings.ConfigTitle}" />
                    </Expander.Header>
                    <controls:ServerConfigurationControl
                        x:Name="ServerConfig"
                        Port="{Binding Port, Mode=TwoWay}"
                        MaxConnections="{Binding MaxConnections, Mode=TwoWay}"
                        CertificateSource="{Binding CertificateSource, Mode=TwoWay}"
                        CertificatePath="{Binding CertificatePath, Mode=TwoWay}"
                        CertificatePassword="{Binding CertificatePassword, Mode=TwoWay}" />
                </Expander>

                <Expander x:Name="UsersExpander" Style="{StaticResource SectionExpander}" IsExpanded="True">
                    <Expander.Header>
                        <controls:ExpanderHeader Icon="👨" Text="{x:Static res:Strings.UsersTab}" />
                    </Expander.Header>
                    <StackPanel>
                        <Button Content="{x:Static res:Strings.AddUserButton}"
                                Style="{StaticResource SecondaryButton}"
                                HorizontalAlignment="Left"
                                Click="AddUser_Click"
                                Margin="0,8,0,8"
                                Padding="16,8"/>
                        <ItemsControl x:Name="UsersItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <controls:UserItemControl RemoveUserRequested="UserItemControl_RemoveUserRequested"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Expander>

                <Expander x:Name="LogsExpander" Style="{StaticResource SectionExpander}" IsExpanded="True" Visibility="Collapsed">
                    <Expander.Header>
                        <controls:ExpanderHeader Icon="📜" Text="{x:Static res:Strings.LogsTab}" />
                    </Expander.Header>
                    <StackPanel>
                        <Button Content="{x:Static res:Strings.ClearLogs}"
                                Style="{StaticResource SecondaryButton}"
                                HorizontalAlignment="Left"
                                Click="ClearLogs_Click"
                                Margin="0,8,0,8"
                                Padding="16,8"/>
                        <Border Background="{StaticResource WindowBackgroundBrush}"
                                CornerRadius="4"
                                Padding="8"
                                MinHeight="200"
                                MaxHeight="400">
                            <ScrollViewer x:Name="LogScrollViewer"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="LogItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding FormattedMessage}"
                                                       Foreground="{Binding Color}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,2"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Expander>
            </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
