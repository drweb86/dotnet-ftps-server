<UserControl x:Class="FtpsServerWindows.Controls.ValidationError"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FtpsServerWindows.Controls"
             Margin="0,4,0,0">
    <UserControl.Resources>
        <controls:NullOrEmptyToVisibilityConverter x:Key="NotEmpty"/>
    </UserControl.Resources>
    <TextBlock Margin="0,4,0,0"
               TextWrapping="Wrap"
               Foreground="{StaticResource ErrorBrush}"
               Text="{Binding Error, RelativeSource={RelativeSource AncestorType=UserControl}}"
               Visibility="{Binding Error, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource NotEmpty}}"/>
</UserControl>
