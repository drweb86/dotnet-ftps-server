<UserControl x:Class="FtpsServerWindows.Controls.TextFieldWithAction"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FtpsServerWindows.Controls"
             Margin="0,8,0,8">
    <UserControl.Resources>
        <controls:NullOrEmptyToVisibilityConverter x:Key="NotEmpty"/>
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Style="{StaticResource ModernLabel}" Margin="0,0,0,8"
                   Text="{Binding Label, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Style="{StaticResource ModernTextBox}" Margin="0,0,8,0"
                     IsReadOnly="{Binding IsReadOnly, RelativeSource={RelativeSource AncestorType=UserControl}}"
                     Text="{Binding Text, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}"
                    Content="{Binding ActionText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Click="ActionButton_Click"/>
        </Grid>
        <TextBlock Margin="0,8,0,0" Style="{StaticResource ModernLabel}" TextWrapping="Wrap"
                   Text="{Binding Help, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   Visibility="{Binding Help, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource NotEmpty}}"/>
        <controls:ValidationError Error="{Binding Error, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
    </StackPanel>
</UserControl>
