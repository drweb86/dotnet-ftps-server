<UserControl x:Class="FtpsServerWindows.Controls.TextField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FtpsServerWindows.Controls"
             Margin="0,8,0,8">
    <UserControl.Resources>
        <controls:NullOrEmptyToVisibilityConverter x:Key="NotEmpty"/>
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Margin="0,0,0,8"
                   Style="{StaticResource ModernLabel}"
                   Text="{Binding Label, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
        <TextBox Style="{StaticResource ModernTextBox}"
                 Text="{Binding Text, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Margin="0,8,0,0"
                   Style="{StaticResource ModernLabel}"
                   TextWrapping="Wrap"
                   Text="{Binding Help, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   Visibility="{Binding Help, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource NotEmpty}}"/>
        <controls:ValidationError Error="{Binding Error, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
    </StackPanel>
</UserControl>
