<UserControl x:Class="FtpsServerWindows.Controls.ConnectionInstructionControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:FtpsServerWindows.Resources">

    <Border Background="{StaticResource TertiaryDarkBrush}"
            BorderBrush="{StaticResource AccentCyanBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="16"
            Margin="10,0,20,20">
        <StackPanel>
            <TextBlock Text="{x:Static res:Strings.ConnectionInstructionTitle}"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       Margin="0,0,0,16"/>

            <WrapPanel Margin="0,0,0,12">
                <Button x:Name="CopyConnectionDetailsButton"
                        Content="{x:Static res:Strings.ConfigCopyConnectionDetails}"
                        Style="{StaticResource SecondaryButton}"
                        Click="CopyConnectionDetails_Click"
                        Margin="0,0,8,8"
                        Padding="16,8"/>
            </WrapPanel>

            <TextBox x:Name="InstructionTextBox"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Disabled"
                     MaxHeight="420"
                     BorderThickness="0"
                     Background="{StaticResource PrimaryDarkBrush}"
                     Foreground="{StaticResource TextPrimaryBrush}"
                     FontSize="13"
                     Padding="8"/>
        </StackPanel>
    </Border>
</UserControl>
