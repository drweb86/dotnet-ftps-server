<UserControl x:Class="FtpsServerWindows.Controls.CheckboxField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FtpsServerWindows.Controls"
             Margin="0,8,0,8">
    <UserControl.Resources>
        <controls:NullOrEmptyToVisibilityConverter x:Key="NotEmpty"/>
    </UserControl.Resources>
    <StackPanel>
        <CheckBox Style="{StaticResource ModernCheckBox}"
                  IsChecked="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                  Content="{Binding Label, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
        <TextBlock Margin="0,8,0,0"
                   Style="{StaticResource ModernLabel}"
                   TextWrapping="Wrap"
                   Text="{Binding Help, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   Visibility="{Binding Help, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource NotEmpty}}"/>
        <controls:ValidationError Error="{Binding Error, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
    </StackPanel>
</UserControl>
