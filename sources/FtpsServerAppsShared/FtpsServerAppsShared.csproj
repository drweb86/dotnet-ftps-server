<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NLog" Version="6.2.0" />
    <PackageReference Include="NLog.Extensions.Logging" Version="6.2.0" />
    <PackageReference Include="NLog.Schema" Version="6.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FtpsServerLibrary\FtpsServerLibrary.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="NLog.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\privacy\desktop\*.md"
                      Exclude="..\..\privacy\desktop\README.md"
                      LogicalName="FtpsServerAppsShared.Privacy.%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\licenses\*.md"
                      Exclude="..\..\licenses\README.md;..\..\licenses\*.official.md"
                      LogicalName="FtpsServerAppsShared.License.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
