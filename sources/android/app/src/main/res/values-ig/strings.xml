    <string name="connection_details_intro_android">Iji jikọọ, ngwaọrụ client ga-anọ n\'otu netwọkụ ekwentị a (otu Wi-Fi, ma ọ bụ otu hotspot / USB tethering).</string>
    <string name="connection_details_intro_desktop">Iji jikọọ, ngwaọrụ client ga-anọ n\'otu netwọkụ kọmputa a (otu Wi-Fi ma ọ bụ LAN).</string>
    <string name="connection_details_clients">Wụnye client ọ bụla nwere FTPS, dịka:\n  • Windows: WinSCP, FileZilla\n  • Linux: FileZilla, lftp\n  • macOS: Cyberduck, FileZilla\n  • Android: Ghost Commander\n  • ma ọ bụ client ọzọ nke na-akwado explicit FTPS</string>
    <string name="connection_details_fill_fields">Dejupụta oghere client dị ka nke a.</string>
    <string name="connection_details_host_title">A. HOST</string>
    <string name="connection_details_host_body">Host bụ adreesị ngwaọrụ ebe FTPS Server na-agba.\nHọrọ adreesị IP. Aha ngwaọrụ na-arụ ọrụ naanị ma netwọkụ nwere ike dozie ya.\n\nJiri otu n\'ime ndị a:</string>
    <string name="connection_details_port_title">B. PORT</string>
    <string name="connection_details_port_body">Port bụ ọnụ ụzọ ngwa n\'ahụ host ahụ.</string>
    <string name="connection_details_encryption_title">C. ENCRYPTION</string>
    <string name="connection_details_encryption_body">FTPS Server na-ezochi iwu na data.\nỌ na-akwado naanị EXPLICIT TLS (AUTH TLS / FTP over TLS).\n\nNa client, họrọ:\n\n  Protocol: FTP\n  Encryption: Explicit TLS\n    (FileZilla: \"Require explicit FTP over TLS\"\n     WinSCP: \"TLS/SSL Explicit encryption\"\n     Cyberduck: \"FTP-SSL (Explicit AUTH TLS)\")\n\nAhọla Implicit FTPS (a na-akpọkarị ya naanị \"FTPS\") — ọ gaghị ejikọ.</string>
    <string name="connection_details_accounts_title">D. LOGIN and PASSWORD</string>
    <string name="connection_details_accounts_body">Ndị a bụ akaụntụ nwere ike ịnweta nchekwa ekerịtara.</string>
    <string name="connection_details_account_format">%1$s. Onye ọrụ %2$s — ohere %3$s na %4$s</string>
    <string name="connection_details_login_label">LOGIN:</string>
    <string name="connection_details_password_label">PASSWORD:</string>
    <string name="connection_details_access_read_write">gụọ/dee</string>
    <string name="connection_details_access_read_only">gụọ naanị</string>
    <string name="connection_details_folder_unspecified">(esetibeghị nchekwa)</string>
    <string name="connection_details_cert_title">E. CERTIFICATE WARNING</string>
    <string name="connection_details_cert_body">Sava a na-eji asambodo onwe ya bịanyere aka. Client ga-adọ gị aka ná ntị.\nTụnyere mkpịsị aka na client na ụkpụrụ dị n\'okpuru. Ọ bụrụ na ha dakọtara, nabata asambodo ahụ.</string>
    <string name="connection_details_cert_sha256_format">SHA-256:  %1$s</string>
    <string name="connection_details_cert_sha1_format">SHA-1:    %1$s</string>
    <string name="connection_details_cert_fingerprint_hint">Ọ bụrụ na client na-egosi naanị \"Fingerprint\" (enweghị aha algorithm), tụnyere SHA-256 mbụ, mgbe ahụ SHA-1.</string>
