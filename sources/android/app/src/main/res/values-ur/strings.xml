    <string name="connection_details_title">کنکشن کی تفصیلات</string>
    <string name="connection_details_intro_android">کنیکٹ کرنے کے لیے کلائنٹ ڈیوائس کو اسی نیٹ ورک پر ہونا چاہیے جس پر یہ فون ہے (وہی Wi-Fi، یا وہی ہاٹ اسپاٹ / USB tethering)۔</string>
    <string name="connection_details_intro_desktop">کنیکٹ کرنے کے لیے کلائنٹ ڈیوائس کو اسی نیٹ ورک پر ہونا چاہیے جس پر یہ کمپیوٹر ہے (وہی Wi-Fi یا LAN)۔</string>
    <string name="connection_details_clients">کوئی بھی FTPS کلائنٹ انسٹال کریں، مثلاً:\n  • Windows: WinSCP, FileZilla\n  • Linux: FileZilla, lftp\n  • macOS: Cyberduck, FileZilla\n  • Android: Ghost Commander\n  • یا کوئی اور کلائنٹ جو explicit FTPS سپورٹ کرتا ہو</string>
    <string name="connection_details_fill_fields">کلائنٹ کے خانے اس طرح بھریں۔</string>
    <string name="connection_details_host_title">A. HOST</string>
    <string name="connection_details_host_body">Host اس ڈیوائس کا پتہ ہے جس پر FTPS Server چل رہا ہے۔\nIP پتہ استعمال کریں۔ ڈیوائس کا نام تبھی کام کرے گا جب نیٹ ورک اسے resolve کر سکے۔\n\nان میں سے ایک استعمال کریں:</string>
    <string name="connection_details_port_title">B. PORT</string>
    <string name="connection_details_port_body">Port اس ہوسٹ پر ایپلیکیشن پورٹ ہے۔</string>
    <string name="connection_details_encryption_title">C. ENCRYPTION</string>
    <string name="connection_details_encryption_body">FTPS Server احکامات اور ڈیٹا دونوں خفیہ کرتا ہے۔\nصرف EXPLICIT TLS (AUTH TLS / FTP over TLS) سپورٹ ہے۔\n\nکلائنٹ میں منتخب کریں:\n\n  Protocol: FTP\n  Encryption: Explicit TLS\n    (FileZilla: \"Require explicit FTP over TLS\"\n     WinSCP: \"TLS/SSL Explicit encryption\"\n     Cyberduck: \"FTP-SSL (Explicit AUTH TLS)\")\n\nImplicit FTPS نہ چنیں (اکثر صرف \"FTPS\" لکھا ہوتا ہے) — کنیکٹ نہیں ہوگا۔</string>
    <string name="connection_details_accounts_title">D. LOGIN and PASSWORD</string>
    <string name="connection_details_accounts_body">وہ اکاؤنٹس جو مشترکہ فولڈرز تک رسائی پا سکتے ہیں۔</string>
    <string name="connection_details_account_format">%1$s. صارف %2$s — %4$s تک %3$s رسائی</string>
