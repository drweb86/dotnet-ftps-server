    <string name="connection_details_cert_title">E. CERTIFICATE WARNING</string>
    <string name="connection_details_cert_body">یہ سرور خود دستخط شدہ سرٹیفکیٹ استعمال کرتا ہے۔ کلائنٹ خبردار کرے گا۔\nکلائنٹ میں فنگر پرنٹ کا موازنہ نیچے دیے گئے قدروں سے کریں۔ میل کھائے تو سرٹیفکیٹ قبول کریں۔</string>
    <string name="connection_details_cert_sha256_format">SHA-256:  %1$s</string>
    <string name="connection_details_cert_sha1_format">SHA-1:    %1$s</string>
    <string name="connection_details_cert_fingerprint_hint">اگر کلائنٹ صرف \"Fingerprint\" دکھائے (الگورتھم کے نام کے بغیر)، پہلے SHA-256 پھر SHA-1 سے موازنہ کریں۔</string>
