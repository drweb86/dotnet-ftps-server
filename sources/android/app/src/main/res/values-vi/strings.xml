    <string name="connection_details_title">Chi tiết kết nối</string>
    <string name="connection_details_intro_android">Để kết nối, thiết bị máy khách phải cùng mạng với điện thoại này (cùng Wi-Fi, hoặc cùng hotspot / USB tethering).</string>
    <string name="connection_details_intro_desktop">Để kết nối, thiết bị máy khách phải cùng mạng với máy tính này (cùng Wi-Fi hoặc LAN).</string>
    <string name="connection_details_clients">Cài đặt một ứng dụng khách hỗ trợ FTPS, ví dụ:\n  • Windows: WinSCP, FileZilla\n  • Linux: FileZilla, lftp\n  • macOS: Cyberduck, FileZilla\n  • Android: Ghost Commander\n  • hoặc ứng dụng khác hỗ trợ FTPS tường minh</string>
    <string name="connection_details_fill_fields">Điền các trường trên máy khách như sau.</string>
    <string name="connection_details_host_title">A. HOST</string>
    <string name="connection_details_host_body">Host là địa chỉ thiết bị đang chạy FTPS Server.\nNên dùng địa chỉ IP. Tên thiết bị chỉ hoạt động nếu mạng phân giải được tên.\n\nDùng một trong:</string>
    <string name="connection_details_port_title">B. PORT</string>
    <string name="connection_details_port_body">Port là cổng ứng dụng trên máy chủ đó.</string>
    <string name="connection_details_encryption_title">C. ENCRYPTION</string>
    <string name="connection_details_encryption_body">FTPS Server mã hóa cả lệnh và dữ liệu.\nChỉ hỗ trợ TLS TƯỜNG MINH (AUTH TLS / FTP over TLS).\n\nTrong máy khách, chọn:\n\n  Protocol: FTP\n  Encryption: Explicit TLS\n    (FileZilla: \"Require explicit FTP over TLS\"\n     WinSCP: \"TLS/SSL Explicit encryption\"\n     Cyberduck: \"FTP-SSL (Explicit AUTH TLS)\")\n\nĐừng chọn FTPS ngầm (thường chỉ ghi \"FTPS\") — sẽ không kết nối được.</string>
    <string name="connection_details_accounts_title">D. LOGIN and PASSWORD</string>
    <string name="connection_details_accounts_body">Đây là các tài khoản có thể truy cập thư mục dùng chung.</string>
    <string name="connection_details_account_format">%1$s. Người dùng %2$s — quyền %3$s tới %4$s</string>
    <string name="connection_details_login_label">LOGIN:</string>
    <string name="connection_details_password_label">PASSWORD:</string>
    <string name="connection_details_access_read_write">đọc/ghi</string>
    <string name="connection_details_access_read_only">chỉ đọc</string>
    <string name="connection_details_folder_unspecified">(chưa đặt thư mục)</string>
    <string name="connection_details_cert_title">E. CERTIFICATE WARNING</string>
    <string name="connection_details_cert_body">Máy chủ này dùng chứng chỉ tự ký. Máy khách sẽ cảnh báo.\nSo sánh vân tay trên máy khách với các giá trị bên dưới. Nếu khớp, hãy chấp nhận chứng chỉ.</string>
    <string name="connection_details_cert_sha256_format">SHA-256:  %1$s</string>
    <string name="connection_details_cert_sha1_format">SHA-1:    %1$s</string>
    <string name="connection_details_cert_fingerprint_hint">Nếu máy khách chỉ hiện \"Fingerprint\" (không có tên thuật toán), hãy so với SHA-256 trước, rồi SHA-1.</string>
