    <string name="connection_details_title">Ulanish tafsilotlari</string>
    <string name="connection_details_intro_android">Ulanish uchun mijoz qurilmasi shu telefon bilan bir xil tarmoqda bo‘lishi kerak (xuddi shu Wi-Fi yoki hotspot / USB tethering).</string>
    <string name="connection_details_intro_desktop">Ulanish uchun mijoz qurilmasi shu kompyuter bilan bir xil tarmoqda bo‘lishi kerak (xuddi shu Wi-Fi yoki LAN).</string>
    <string name="connection_details_clients">FTPS ni qo‘llab-quvvatlovchi istalgan mijozni o‘rnating, masalan:\n  • Windows: WinSCP, FileZilla\n  • Linux: FileZilla, lftp\n  • macOS: Cyberduck, FileZilla\n  • Android: Ghost Commander\n  • yoki explicit FTPS ni qo‘llab-quvvatlovchi boshqa mijoz</string>
    <string name="connection_details_fill_fields">Mijoz maydonlarini quyidagicha to‘ldiring.</string>
    <string name="connection_details_host_title">A. HOST</string>
    <string name="connection_details_host_body">Host — FTPS Server ishlayotgan qurilma manzili.\nIP manzilni afzal ko‘ring. Qurilma nomi tarmoq uni aniqlasagina ishlaydi.\n\nQuyidagilardan birini ishlating:</string>
    <string name="connection_details_port_title">B. PORT</string>
    <string name="connection_details_port_body">Port — shu xostdagi ilova porti.</string>
    <string name="connection_details_encryption_title">C. ENCRYPTION</string>
    <string name="connection_details_encryption_body">FTPS Server buyruqlar va ma’lumotlarni shifrlaydi.\nFaqat EXPLICIT TLS (AUTH TLS / FTP over TLS) qo‘llab-quvvatlanadi.\n\nMijozda tanlang:\n\n  Protocol: FTP\n  Encryption: Explicit TLS\n    (FileZilla: \"Require explicit FTP over TLS\"\n     WinSCP: \"TLS/SSL Explicit encryption\"\n     Cyberduck: \"FTP-SSL (Explicit AUTH TLS)\")\n\nImplicit FTPS ni tanlamang (ko‘pincha faqat \"FTPS\" deb yoziladi) — ulanmaydi.</string>
    <string name="connection_details_accounts_title">D. LOGIN and PASSWORD</string>
    <string name="connection_details_accounts_body">Umumiy jildlarga kira oladigan hisoblar.</string>
    <string name="connection_details_account_format">%1$s. Foydalanuvchi %2$s — %4$s uchun %3$s ruxsat</string>
    <string name="connection_details_login_label">LOGIN:</string>
    <string name="connection_details_password_label">PASSWORD:</string>
    <string name="connection_details_access_read_write">o‘qish/yozish</string>
    <string name="connection_details_access_read_only">faqat o‘qish</string>
    <string name="connection_details_folder_unspecified">(jild belgilanmagan)</string>
    <string name="connection_details_cert_title">E. CERTIFICATE WARNING</string>
    <string name="connection_details_cert_body">Bu server o‘z-o‘ziga imzo chekilgan sertifikatdan foydalanadi. Mijoz ogohlantiradi.\nMijozdagi barmoq izini quyidagi qiymatlar bilan solishtiring. Mos kelsa, sertifikatni qabul qiling.</string>
    <string name="connection_details_cert_sha256_format">SHA-256:  %1$s</string>
    <string name="connection_details_cert_sha1_format">SHA-1:    %1$s</string>
    <string name="connection_details_cert_fingerprint_hint">Agar mijoz faqat \"Fingerprint\" ko‘rsatsa (algoritm nomisiz), avval SHA-256, keyin SHA-1 bilan solishtiring.</string>
