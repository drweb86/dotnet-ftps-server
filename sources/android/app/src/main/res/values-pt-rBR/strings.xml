    <string name="connection_details_title">Dados de conexão</string>
    <string name="connection_details_intro_android">Para conectar, o dispositivo cliente precisa estar na mesma rede que este telefone (mesmo Wi-Fi, ou o mesmo ponto de acesso / tethering USB).</string>
    <string name="connection_details_intro_desktop">Para conectar, o dispositivo cliente precisa estar na mesma rede que este computador (mesmo Wi-Fi ou LAN).</string>
    <string name="connection_details_clients">Instale qualquer cliente compatível com FTPS, por exemplo:\n  • Windows: WinSCP, FileZilla\n  • Linux: FileZilla, lftp\n  • macOS: Cyberduck, FileZilla\n  • Android: Ghost Commander\n  • ou outro cliente que suporte FTPS explícito</string>
    <string name="connection_details_fill_fields">Preencha os campos do cliente assim.</string>
    <string name="connection_details_host_title">A. HOST</string>
    <string name="connection_details_host_body">Host é o endereço do dispositivo em que o FTPS Server está em execução.\nPrefira um endereço IP. O nome do dispositivo só funciona se a rede puder resolvê-lo.\n\nUse um de:</string>
    <string name="connection_details_port_title">B. PORT</string>
    <string name="connection_details_port_body">Porta é a porta do aplicativo nesse host.</string>
    <string name="connection_details_encryption_title">C. ENCRYPTION</string>
    <string name="connection_details_encryption_body">O FTPS Server criptografa comandos e dados.\nHá suporte apenas a TLS EXPLÍCITO (AUTH TLS / FTP over TLS).\n\nNo cliente, escolha:\n\n  Protocol: FTP\n  Encryption: Explicit TLS\n    (FileZilla: \"Require explicit FTP over TLS\"\n     WinSCP: \"TLS/SSL Explicit encryption\"\n     Cyberduck: \"FTP-SSL (Explicit AUTH TLS)\")\n\nNão escolha FTPS implícito (muitas vezes rotulado só como \"FTPS\") — não vai conectar.</string>
    <string name="connection_details_accounts_title">D. LOGIN and PASSWORD</string>
    <string name="connection_details_accounts_body">Estas são as contas que podem acessar as pastas compartilhadas.</string>
    <string name="connection_details_account_format">%1$s. Usuário %2$s — acesso %3$s a %4$s</string>
    <string name="connection_details_login_label">LOGIN:</string>
    <string name="connection_details_password_label">PASSWORD:</string>
    <string name="connection_details_access_read_write">leitura/gravação</string>
    <string name="connection_details_access_read_only">somente leitura</string>
    <string name="connection_details_folder_unspecified">(pasta não definida)</string>
    <string name="connection_details_cert_title">E. CERTIFICATE WARNING</string>
    <string name="connection_details_cert_body">Este servidor usa um certificado autoassinado. O cliente avisará você.\nCompare a impressão no cliente com os valores abaixo. Se coincidirem, aceite o certificado.</string>
    <string name="connection_details_cert_sha256_format">SHA-256:  %1$s</string>
    <string name="connection_details_cert_sha1_format">SHA-1:    %1$s</string>
    <string name="connection_details_cert_fingerprint_hint">Se o cliente mostrar só \"Fingerprint\" (sem algoritmo), compare primeiro com SHA-256 e depois com SHA-1.</string>
