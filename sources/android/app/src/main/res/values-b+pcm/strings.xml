    <string name="connection_details_title">Connection details</string>
    <string name="connection_details_intro_android">To connect, di client device must dey for di same network as dis phone (same Wi-Fi, or di same hotspot / USB tethering).</string>
    <string name="connection_details_intro_desktop">To connect, di client device must dey for di same network as dis computer (same Wi-Fi or LAN).</string>
    <string name="connection_details_clients">Install any client wey fit do FTPS, for example:\n  • Windows: WinSCP, FileZilla\n  • Linux: FileZilla, lftp\n  • macOS: Cyberduck, FileZilla\n  • Android: Ghost Commander\n  • or any oda client wey support explicit FTPS</string>
    <string name="connection_details_fill_fields">Fill di client fields like dis.</string>
    <string name="connection_details_host_title">A. HOST</string>
    <string name="connection_details_host_body">Host na di address of di device wey FTPS Server dey run.\nUse IP address. Di device name go work only if di network fit resolve am.\n\nUse one of:</string>
    <string name="connection_details_port_title">B. PORT</string>
    <string name="connection_details_port_body">Port na di application port for dat host.</string>
    <string name="connection_details_encryption_title">C. ENCRYPTION</string>
    <string name="connection_details_encryption_body">FTPS Server dey encrypt both commands and data.\nE only support EXPLICIT TLS (AUTH TLS / FTP over TLS).\n\nFor di client, choose:\n\n  Protocol: FTP\n  Encryption: Explicit TLS\n    (FileZilla: \"Require explicit FTP over TLS\"\n     WinSCP: \"TLS/SSL Explicit encryption\"\n     Cyberduck: \"FTP-SSL (Explicit AUTH TLS)\")\n\nNo choose Implicit FTPS (dem often just write \"FTPS\") — e no go connect.</string>
    <string name="connection_details_accounts_title">D. LOGIN and PASSWORD</string>
    <string name="connection_details_accounts_body">Na dis accounts fit enter di shared folders.</string>
    <string name="connection_details_account_format">%1$s. User %2$s — %3$s access to %4$s</string>
    <string name="connection_details_login_label">LOGIN:</string>
    <string name="connection_details_password_label">PASSWORD:</string>
    <string name="connection_details_access_read_write">read/write</string>
    <string name="connection_details_access_read_only">read-only</string>
    <string name="connection_details_folder_unspecified">(folder no set)</string>
    <string name="connection_details_cert_title">E. CERTIFICATE WARNING</string>
    <string name="connection_details_cert_body">Dis server dey use self-signed certificate. Di client go warn you.\nCompare di fingerprint for di client with di values below. If dem match, accept di certificate.</string>
    <string name="connection_details_cert_sha256_format">SHA-256:  %1$s</string>
    <string name="connection_details_cert_sha1_format">SHA-1:    %1$s</string>
    <string name="connection_details_cert_fingerprint_hint">If di client show only \"Fingerprint\" (no algorithm name), compare am to SHA-256 first, then SHA-1.</string>
