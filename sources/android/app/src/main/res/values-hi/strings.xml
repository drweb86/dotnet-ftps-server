    <string name="connection_details_title">कनेक्शन विवरण</string>
    <string name="connection_details_intro_android">कनेक्ट करने के लिए क्लाइंट डिवाइस इसी फ़ोन वाले नेटवर्क पर होना चाहिए (वही Wi-Fi, या वही हॉटस्पॉट / USB टेदरिंग)।</string>
    <string name="connection_details_intro_desktop">कनेक्ट करने के लिए क्लाइंट डिवाइस इसी कंप्यूटर वाले नेटवर्क पर होना चाहिए (वही Wi-Fi या LAN)।</string>
    <string name="connection_details_clients">कोई भी FTPS-सक्षम क्लाइंट इंस्टॉल करें, उदाहरण:\n  • Windows: WinSCP, FileZilla\n  • Linux: FileZilla, lftp\n  • macOS: Cyberduck, FileZilla\n  • Android: Ghost Commander\n  • या कोई अन्य क्लाइंट जो explicit FTPS सपोर्ट करता हो</string>
    <string name="connection_details_fill_fields">क्लाइंट फ़ील्ड इस तरह भरें।</string>
    <string name="connection_details_host_title">A. HOST</string>
    <string name="connection_details_host_body">Host उस डिवाइस का पता है जिस पर FTPS Server चल रहा है।\nIP पता बेहतर है। डिवाइस नाम तभी काम करेगा जब नेटवर्क उसे resolve कर सके।\n\nइनमें से एक उपयोग करें:</string>
    <string name="connection_details_port_title">B. PORT</string>
    <string name="connection_details_port_body">Port उस होस्ट पर एप्लिकेशन पोर्ट है।</string>
    <string name="connection_details_encryption_title">C. ENCRYPTION</string>
    <string name="connection_details_encryption_body">FTPS Server कमांड और डेटा दोनों एन्क्रिप्ट करता है।\nकेवल EXPLICIT TLS (AUTH TLS / FTP over TLS) समर्थित है।\n\nक्लाइंट में चुनें:\n\n  Protocol: FTP\n  Encryption: Explicit TLS\n    (FileZilla: \"Require explicit FTP over TLS\"\n     WinSCP: \"TLS/SSL Explicit encryption\"\n     Cyberduck: \"FTP-SSL (Explicit AUTH TLS)\")\n\nImplicit FTPS न चुनें (अक्सर केवल \"FTPS\" लिखा होता है) — कनेक्ट नहीं होगा।</string>
    <string name="connection_details_accounts_title">D. LOGIN and PASSWORD</string>
    <string name="connection_details_accounts_body">ये खाते साझा फ़ोल्डर तक पहुँच सकते हैं।</string>
    <string name="connection_details_account_format">%1$s. उपयोगकर्ता %2$s — %4$s पर %3$s पहुँच</string>
    <string name="connection_details_login_label">LOGIN:</string>
    <string name="connection_details_password_label">PASSWORD:</string>
    <string name="connection_details_access_read_write">पढ़ना/लिखना</string>
    <string name="connection_details_access_read_only">केवल पढ़ना</string>
    <string name="connection_details_folder_unspecified">(फ़ोल्डर सेट नहीं)</string>
    <string name="connection_details_cert_title">E. CERTIFICATE WARNING</string>
    <string name="connection_details_cert_body">यह सर्वर स्व-हस्ताक्षरित प्रमाणपत्र उपयोग करता है। क्लाइंट चेतावनी दिखाएगा।\nक्लाइंट में फ़िंगरप्रिंट की तुलना नीचे दिए मानों से करें। मेल खाए तो प्रमाणपत्र स्वीकार करें।</string>
    <string name="connection_details_cert_sha256_format">SHA-256:  %1$s</string>
    <string name="connection_details_cert_sha1_format">SHA-1:    %1$s</string>
    <string name="connection_details_cert_fingerprint_hint">यदि क्लाइंट केवल \"Fingerprint\" दिखाए (एल्गोरिद्म नाम के बिना), पहले SHA-256 फिर SHA-1 से तुलना करें।</string>
