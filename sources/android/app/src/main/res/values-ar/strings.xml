    <string name="connection_details_title">تفاصيل الاتصال</string>
    <string name="connection_details_intro_android">للاتصال يجب أن يكون جهاز العميل على نفس شبكة هذا الهاتف (نفس Wi-Fi أو نفس نقطة الاتصال / مشاركة USB).</string>
    <string name="connection_details_intro_desktop">للاتصال يجب أن يكون جهاز العميل على نفس شبكة هذا الحاسوب (نفس Wi-Fi أو الشبكة المحلية).</string>
    <string name="connection_details_clients">ثبّت أي عميل يدعم FTPS، على سبيل المثال:\n  • Windows: WinSCP, FileZilla\n  • Linux: FileZilla, lftp\n  • macOS: Cyberduck, FileZilla\n  • Android: Ghost Commander\n  • أو أي عميل آخر يدعم FTPS الصريح</string>
    <string name="connection_details_fill_fields">املأ حقول العميل كما يلي.</string>
    <string name="connection_details_host_title">A. HOST</string>
    <string name="connection_details_host_body">Host هو عنوان الجهاز الذي يعمل عليه FTPS Server.\nيفضّل عنوان IP. اسم الجهاز يعمل فقط إذا كانت الشبكة قادرة على حله.\n\nاستخدم واحدًا مما يلي:</string>
    <string name="connection_details_port_title">B. PORT</string>
    <string name="connection_details_port_body">Port هو منفذ التطبيق على ذلك المضيف.</string>
    <string name="connection_details_encryption_title">C. ENCRYPTION</string>
    <string name="connection_details_encryption_body">يشفر FTPS Server الأوامر والبيانات.\nيدعم فقط TLS الصريح (AUTH TLS / FTP over TLS).\n\nفي العميل اختر:\n\n  Protocol: FTP\n  Encryption: Explicit TLS\n    (FileZilla: \"Require explicit FTP over TLS\"\n     WinSCP: \"TLS/SSL Explicit encryption\"\n     Cyberduck: \"FTP-SSL (Explicit AUTH TLS)\")\n\nلا تختر FTPS الضمني (غالبًا يُسمّى فقط \"FTPS\") — لن يتم الاتصال.</string>
    <string name="connection_details_accounts_title">D. LOGIN and PASSWORD</string>
    <string name="connection_details_accounts_body">هذه الحسابات التي يمكنها الوصول إلى المجلدات المشتركة.</string>
    <string name="connection_details_account_format">%1$s. المستخدم %2$s — وصول %3$s إلى %4$s</string>
    <string name="connection_details_login_label">LOGIN:</string>
    <string name="connection_details_password_label">PASSWORD:</string>
    <string name="connection_details_access_read_write">قراءة/كتابة</string>
    <string name="connection_details_access_read_only">قراءة فقط</string>
    <string name="connection_details_folder_unspecified">(لم يُحدد مجلد)</string>
    <string name="connection_details_cert_title">E. CERTIFICATE WARNING</string>
    <string name="connection_details_cert_body">يستخدم هذا الخادم شهادة موقعة ذاتيًا. سيحذرك العميل.\nقارن البصمة في العميل بالقيم أدناه. إذا تطابقت فاقبل الشهادة.</string>
    <string name="connection_details_cert_sha256_format">SHA-256:  %1$s</string>
    <string name="connection_details_cert_sha1_format">SHA-1:    %1$s</string>
    <string name="connection_details_cert_fingerprint_hint">إذا عرض العميل \"Fingerprint\" فقط (بدون اسم الخوارزمية) فقارن أولًا مع SHA-256 ثم SHA-1.</string>
