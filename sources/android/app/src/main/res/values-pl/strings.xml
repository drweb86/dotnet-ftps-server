    <string name="connection_details_title">Dane połączenia</string>
    <string name="connection_details_intro_android">Aby się połączyć, urządzenie klienckie musi być w tej samej sieci co ten telefon (to samo Wi-Fi albo ten sam hotspot / tethering USB).</string>
    <string name="connection_details_intro_desktop">Aby się połączyć, urządzenie klienckie musi być w tej samej sieci co ten komputer (to samo Wi-Fi lub LAN).</string>
    <string name="connection_details_clients">Zainstaluj dowolnego klienta obsługującego FTPS, na przykład:\n  • Windows: WinSCP, FileZilla\n  • Linux: FileZilla, lftp\n  • macOS: Cyberduck, FileZilla\n  • Android: Ghost Commander\n  • lub inny klient z jawnym FTPS</string>
    <string name="connection_details_fill_fields">Wypełnij pola klienta w następujący sposób.</string>
    <string name="connection_details_host_title">A. HOST</string>
    <string name="connection_details_host_body">Host to adres urządzenia z uruchomionym FTPS Server.\nLepiej podać adres IP. Nazwa urządzenia zadziała tylko wtedy, gdy sieć potrafi ją rozwiązać.\n\nUżyj jednej z wartości:</string>
    <string name="connection_details_port_title">B. PORT</string>
    <string name="connection_details_port_body">Port to port aplikacji na tym hoście.</string>
    <string name="connection_details_encryption_title">C. ENCRYPTION</string>
    <string name="connection_details_encryption_body">FTPS Server szyfruje polecenia i dane.\nObsługiwany jest tylko JAWY TLS (AUTH TLS / FTP over TLS).\n\nW kliencie wybierz:\n\n  Protocol: FTP\n  Encryption: Explicit TLS\n    (FileZilla: \"Require explicit FTP over TLS\"\n     WinSCP: \"TLS/SSL Explicit encryption\"\n     Cyberduck: \"FTP-SSL (Explicit AUTH TLS)\")\n\nNie wybieraj niejawnego FTPS (często opisanego tylko jako „FTPS”) — połączenie nie zadziała.</string>
    <string name="connection_details_accounts_title">D. LOGIN and PASSWORD</string>
    <string name="connection_details_accounts_body">To konta z dostępem do udostępnionych folderów.</string>
    <string name="connection_details_account_format">%1$s. Użytkownik %2$s — dostęp %3$s do %4$s</string>
    <string name="connection_details_login_label">LOGIN:</string>
    <string name="connection_details_password_label">PASSWORD:</string>
    <string name="connection_details_access_read_write">odczyt/zapis</string>
    <string name="connection_details_access_read_only">tylko odczyt</string>
    <string name="connection_details_folder_unspecified">(folder nieustawiony)</string>
    <string name="connection_details_cert_title">E. CERTIFICATE WARNING</string>
    <string name="connection_details_cert_body">Serwer używa certyfikatu z podpisem własnym. Klient wyświetli ostrzeżenie.\nPorównaj odcisk w kliencie z wartościami poniżej. Jeśli się zgadzają, zaakceptuj certyfikat.</string>
    <string name="connection_details_cert_sha256_format">SHA-256:  %1$s</string>
    <string name="connection_details_cert_sha1_format">SHA-1:    %1$s</string>
    <string name="connection_details_cert_fingerprint_hint">Jeśli klient pokazuje tylko „Fingerprint” (bez algorytmu), porównaj najpierw z SHA-256, potem z SHA-1.</string>
