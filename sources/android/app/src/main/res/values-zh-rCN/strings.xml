    <string name="connection_details_title">连接详情</string>
    <string name="connection_details_intro_android">要连接，客户端设备必须与此手机位于同一网络（同一 Wi-Fi，或同一热点 / USB 网络共享）。</string>
    <string name="connection_details_intro_desktop">要连接，客户端设备必须与此电脑位于同一网络（同一 Wi-Fi 或局域网）。</string>
    <string name="connection_details_clients">请安装支持 FTPS 的客户端，例如：\n  • Windows: WinSCP, FileZilla\n  • Linux: FileZilla, lftp\n  • macOS: Cyberduck, FileZilla\n  • Android: Ghost Commander\n  • 或其他支持显式 FTPS 的客户端</string>
    <string name="connection_details_fill_fields">请按如下方式填写客户端字段。</string>
    <string name="connection_details_host_title">A. HOST</string>
    <string name="connection_details_host_body">Host 是运行 FTPS Server 的设备地址。\n请优先使用 IP 地址。只有在网络能解析设备名称时，名称才可用。\n\n请使用以下之一：</string>
    <string name="connection_details_port_title">B. PORT</string>
    <string name="connection_details_port_body">Port 是该主机上的应用程序端口。</string>
    <string name="connection_details_encryption_title">C. ENCRYPTION</string>
    <string name="connection_details_encryption_body">FTPS Server 会加密命令和数据。\n仅支持显式 TLS（AUTH TLS / FTP over TLS）。\n\n在客户端中选择：\n\n  Protocol: FTP\n  Encryption: Explicit TLS\n    (FileZilla: \"Require explicit FTP over TLS\"\n     WinSCP: \"TLS/SSL Explicit encryption\"\n     Cyberduck: \"FTP-SSL (Explicit AUTH TLS)\")\n\n不要选择隐式 FTPS（常仅标记为“FTPS”）——将无法连接。</string>
    <string name="connection_details_accounts_title">D. LOGIN and PASSWORD</string>
    <string name="connection_details_accounts_body">以下是可以访问共享文件夹的帐户。</string>
    <string name="connection_details_account_format">%1$s. 用户 %2$s — 对 %4$s 的%3$s权限</string>
    <string name="connection_details_login_label">LOGIN:</string>
    <string name="connection_details_password_label">PASSWORD:</string>
    <string name="connection_details_access_read_write">读写</string>
    <string name="connection_details_access_read_only">只读</string>
    <string name="connection_details_folder_unspecified">（未设置文件夹）</string>
    <string name="connection_details_cert_title">E. CERTIFICATE WARNING</string>
    <string name="connection_details_cert_body">此服务器使用自签名证书。客户端会显示警告。\n请将客户端中的指纹与下面的值比较。如果匹配，请接受该证书。</string>
    <string name="connection_details_cert_sha256_format">SHA-256:  %1$s</string>
    <string name="connection_details_cert_sha1_format">SHA-1:    %1$s</string>
    <string name="connection_details_cert_fingerprint_hint">如果客户端仅显示“Fingerprint”（无算法名称），请先与 SHA-256 比较，再与 SHA-1 比较。</string>
