    <string name="connection_details_intro_android">Bağlanmak için istemci cihaz bu telefonla aynı ağda olmalıdır (aynı Wi-Fi veya aynı erişim noktası / USB tethering).</string>
    <string name="connection_details_intro_desktop">Bağlanmak için istemci cihaz bu bilgisayarla aynı ağda olmalıdır (aynı Wi-Fi veya LAN).</string>
    <string name="connection_details_clients">FTPS destekleyen bir istemci kurun, örneğin:\n  • Windows: WinSCP, FileZilla\n  • Linux: FileZilla, lftp\n  • macOS: Cyberduck, FileZilla\n  • Android: Ghost Commander\n  • veya açık FTPS destekleyen başka bir istemci</string>
    <string name="connection_details_fill_fields">İstemci alanlarını şöyle doldurun.</string>
    <string name="connection_details_host_title">A. HOST</string>
    <string name="connection_details_host_body">Host, FTPS Server\'ın çalıştığı cihazın adresidir.\nBir IP adresi tercih edin. Cihaz adı yalnızca ağ çözümlendirebiliyorsa çalışır.\n\nŞunlardan birini kullanın:</string>
    <string name="connection_details_port_title">B. PORT</string>
    <string name="connection_details_port_body">Port, o ana bilgisayardaki uygulama bağlantı noktasıdır.</string>
    <string name="connection_details_encryption_title">C. ENCRYPTION</string>
    <string name="connection_details_encryption_body">FTPS Server komutları ve verileri şifreler.\nYalnızca AÇIK TLS (AUTH TLS / FTP over TLS) desteklenir.\n\nİstemcide şunu seçin:\n\n  Protocol: FTP\n  Encryption: Explicit TLS\n    (FileZilla: \"Require explicit FTP over TLS\"\n     WinSCP: \"TLS/SSL Explicit encryption\"\n     Cyberduck: \"FTP-SSL (Explicit AUTH TLS)\")\n\nÖrtük FTPS seçmeyin (çoğu zaman yalnızca \"FTPS\" olarak etiketlenir) — bağlanmaz.</string>
    <string name="connection_details_accounts_title">D. LOGIN and PASSWORD</string>
    <string name="connection_details_accounts_body">Paylaşılan klasörlere erişebilen hesaplar bunlardır.</string>
    <string name="connection_details_account_format">%1$s. Kullanıcı %2$s — %4$s için %3$s erişim</string>
    <string name="connection_details_login_label">LOGIN:</string>
    <string name="connection_details_password_label">PASSWORD:</string>
    <string name="connection_details_access_read_write">okuma/yazma</string>
    <string name="connection_details_access_read_only">salt okunur</string>
    <string name="connection_details_folder_unspecified">(klasör ayarlanmadı)</string>
    <string name="connection_details_cert_title">E. CERTIFICATE WARNING</string>
    <string name="connection_details_cert_body">Bu sunucu kendi imzaladığı bir sertifika kullanır. İstemci sizi uyarır.\nİstemcideki parmak izini aşağıdaki değerlerle karşılaştırın. Eşleşirse sertifikayı kabul edin.</string>
    <string name="connection_details_cert_sha256_format">SHA-256:  %1$s</string>
    <string name="connection_details_cert_sha1_format">SHA-1:    %1$s</string>
    <string name="connection_details_cert_fingerprint_hint">İstemci yalnızca \"Fingerprint\" (algoritma adı yok) gösteriyorsa önce SHA-256, sonra SHA-1 ile karşılaştırın.</string>
