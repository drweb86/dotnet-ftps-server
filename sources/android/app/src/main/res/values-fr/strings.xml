    <string name="connection_details_title">Informations de connexion</string>
    <string name="connection_details_intro_android">Pour vous connecter, l\'appareil client doit être sur le même réseau que ce téléphone (même Wi-Fi, ou même point d\'accès / partage USB).</string>
    <string name="connection_details_intro_desktop">Pour vous connecter, l\'appareil client doit être sur le même réseau que cet ordinateur (même Wi-Fi ou LAN).</string>
    <string name="connection_details_clients">Installez un client compatible FTPS, par exemple :\n  • Windows: WinSCP, FileZilla\n  • Linux: FileZilla, lftp\n  • macOS: Cyberduck, FileZilla\n  • Android: Ghost Commander\n  • ou tout autre client prenant en charge le FTPS explicite</string>
    <string name="connection_details_fill_fields">Renseignez les champs du client comme suit.</string>
    <string name="connection_details_host_title">A. HOST</string>
    <string name="connection_details_host_body">Host est l\'adresse de l\'appareil qui exécute FTPS Server.\nPréférez une adresse IP. Le nom de l\'appareil ne fonctionne que si le réseau peut le résoudre.\n\nUtilisez l\'une des valeurs suivantes :</string>
    <string name="connection_details_port_title">B. PORT</string>
    <string name="connection_details_port_body">Port est le port de l\'application sur cet hôte.</string>
    <string name="connection_details_encryption_title">C. ENCRYPTION</string>
    <string name="connection_details_encryption_body">FTPS Server chiffre les commandes et les données.\nSeul le TLS EXPLICITE (AUTH TLS / FTP over TLS) est pris en charge.\n\nDans le client, choisissez :\n\n  Protocol: FTP\n  Encryption: Explicit TLS\n    (FileZilla: \"Require explicit FTP over TLS\"\n     WinSCP: \"TLS/SSL Explicit encryption\"\n     Cyberduck: \"FTP-SSL (Explicit AUTH TLS)\")\n\nNe choisissez pas le FTPS implicite (souvent étiqueté seulement « FTPS ») — la connexion échouera.</string>
    <string name="connection_details_accounts_title">D. LOGIN and PASSWORD</string>
    <string name="connection_details_accounts_body">Voici les comptes qui peuvent accéder aux dossiers partagés.</string>
    <string name="connection_details_account_format">%1$s. Utilisateur %2$s — accès %3$s à %4$s</string>
    <string name="connection_details_login_label">LOGIN:</string>
    <string name="connection_details_password_label">PASSWORD:</string>
    <string name="connection_details_access_read_write">lecture/écriture</string>
    <string name="connection_details_access_read_only">lecture seule</string>
    <string name="connection_details_folder_unspecified">(dossier non défini)</string>
    <string name="connection_details_cert_title">E. CERTIFICATE WARNING</string>
    <string name="connection_details_cert_body">Ce serveur utilise un certificat auto-signé. Le client affichera un avertissement.\nComparez l\'empreinte du client aux valeurs ci-dessous. Si elles correspondent, acceptez le certificat.</string>
    <string name="connection_details_cert_sha256_format">SHA-256:  %1$s</string>
    <string name="connection_details_cert_sha1_format">SHA-1:    %1$s</string>
    <string name="connection_details_cert_fingerprint_hint">Si le client affiche seulement « Fingerprint » (sans algorithme), comparez d\'abord à SHA-256, puis à SHA-1.</string>
