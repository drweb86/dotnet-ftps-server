    <string name="connection_details_title">Datos de conexión</string>
    <string name="connection_details_intro_android">Para conectar, el dispositivo cliente debe estar en la misma red que este teléfono (la misma Wi-Fi, o el mismo punto de acceso / anclaje USB).</string>
    <string name="connection_details_intro_desktop">Para conectar, el dispositivo cliente debe estar en la misma red que este equipo (la misma Wi-Fi o LAN).</string>
    <string name="connection_details_clients">Instale cualquier cliente compatible con FTPS, por ejemplo:\n  • Windows: WinSCP, FileZilla\n  • Linux: FileZilla, lftp\n  • macOS: Cyberduck, FileZilla\n  • Android: Ghost Commander\n  • u otro cliente que admita FTPS explícito</string>
    <string name="connection_details_fill_fields">Rellene los campos del cliente así.</string>
    <string name="connection_details_host_title">A. HOST</string>
    <string name="connection_details_host_body">Host es la dirección del dispositivo donde se ejecuta FTPS Server.\nPrefiera una dirección IP. El nombre del dispositivo solo funciona si la red puede resolverlo.\n\nUse uno de:</string>
    <string name="connection_details_port_title">B. PORT</string>
    <string name="connection_details_port_body">Puerto es el puerto de la aplicación en ese host.</string>
    <string name="connection_details_encryption_title">C. ENCRYPTION</string>
    <string name="connection_details_encryption_body">FTPS Server cifra tanto los comandos como los datos.\nSolo admite TLS EXPLÍCITO (AUTH TLS / FTP over TLS).\n\nEn el cliente, elija:\n\n  Protocol: FTP\n  Encryption: Explicit TLS\n    (FileZilla: \"Require explicit FTP over TLS\"\n     WinSCP: \"TLS/SSL Explicit encryption\"\n     Cyberduck: \"FTP-SSL (Explicit AUTH TLS)\")\n\nNo elija FTPS implícito (a menudo etiquetado solo como \"FTPS\") — no conectará.</string>
    <string name="connection_details_accounts_title">D. LOGIN and PASSWORD</string>
    <string name="connection_details_accounts_body">Estas son las cuentas que pueden acceder a las carpetas compartidas.</string>
    <string name="connection_details_account_format">%1$s. Usuario %2$s — acceso %3$s a %4$s</string>
    <string name="connection_details_login_label">LOGIN:</string>
    <string name="connection_details_password_label">PASSWORD:</string>
    <string name="connection_details_access_read_write">lectura/escritura</string>
    <string name="connection_details_access_read_only">solo lectura</string>
    <string name="connection_details_folder_unspecified">(carpeta no definida)</string>
    <string name="connection_details_cert_title">E. CERTIFICATE WARNING</string>
    <string name="connection_details_cert_body">Este servidor usa un certificado autofirmado. El cliente le avisará.\nCompare la huella del cliente con los valores de abajo. Si coinciden, acepte el certificado.</string>
    <string name="connection_details_cert_sha256_format">SHA-256:  %1$s</string>
    <string name="connection_details_cert_sha1_format">SHA-1:    %1$s</string>
    <string name="connection_details_cert_fingerprint_hint">Si el cliente muestra solo \"Fingerprint\" (sin algoritmo), compárela primero con SHA-256 y luego con SHA-1.</string>
    <string name="connection_details_share_subject">Datos de conexión de FTPS Server</string>
    <string name="connection_instruction_title">Instrucciones de conexión</string>
    <string name="config_port_help">El puerto es el número que usa un cliente FTP para llegar a este servidor en la red. El valor predeterminado es 2121.</string>
