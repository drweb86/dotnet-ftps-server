    <string name="connection_details_title">সংযোগের বিবরণ</string>
    <string name="connection_details_intro_android">সংযোগ করতে ক্লায়েন্ট ডিভাইসকে এই ফোনের একই নেটওয়ার্কে থাকতে হবে (একই Wi-Fi, বা একই হটস্পট / USB টেথারিং)।</string>
    <string name="connection_details_intro_desktop">সংযোগ করতে ক্লায়েন্ট ডিভাইসকে এই কম্পিউটারের একই নেটওয়ার্কে থাকতে হবে (একই Wi-Fi বা LAN)।</string>
    <string name="connection_details_clients">যেকোনো FTPS-সক্ষম ক্লায়েন্ট ইনস্টল করুন, যেমন:\n  • Windows: WinSCP, FileZilla\n  • Linux: FileZilla, lftp\n  • macOS: Cyberduck, FileZilla\n  • Android: Ghost Commander\n  • বা অন্য ক্লায়েন্ট যা explicit FTPS সমর্থন করে</string>
    <string name="connection_details_fill_fields">ক্লায়েন্টের ঘরগুলো এভাবে পূরণ করুন।</string>
    <string name="connection_details_host_title">A. HOST</string>
    <string name="connection_details_host_body">Host হলো সেই ডিভাইসের ঠিকানা যেখানে FTPS Server চলছে।\nIP ঠিকানা ব্যবহার করুন। ডিভাইসের নাম কেবল নেটওয়ার্ক তা resolve করতে পারলে কাজ করবে।\n\nএগুলোর একটি ব্যবহার করুন:</string>
    <string name="connection_details_port_title">B. PORT</string>
    <string name="connection_details_port_body">Port হলো সেই হোস্টের অ্যাপ্লিকেশন পোর্ট।</string>
    <string name="connection_details_encryption_title">C. ENCRYPTION</string>
    <string name="connection_details_encryption_body">FTPS Server কমান্ড ও ডেটা দুটোই এনক্রিপ্ট করে।\nশুধু EXPLICIT TLS (AUTH TLS / FTP over TLS) সমর্থিত।\n\nক্লায়েন্টে বেছে নিন:\n\n  Protocol: FTP\n  Encryption: Explicit TLS\n    (FileZilla: \"Require explicit FTP over TLS\"\n     WinSCP: \"TLS/SSL Explicit encryption\"\n     Cyberduck: \"FTP-SSL (Explicit AUTH TLS)\")\n\nImplicit FTPS বেছে নেবেন না (প্রায়ই শুধু \"FTPS\" লেখা থাকে) — সংযোগ হবে না।</string>
    <string name="connection_details_accounts_title">D. LOGIN and PASSWORD</string>
    <string name="connection_details_accounts_body">শেয়ার করা ফোল্ডারে প্রবেশ করতে পারে এমন অ্যাকাউন্ট।</string>
    <string name="connection_details_account_format">%1$s. ব্যবহারকারী %2$s — %4$s-এ %3$s অ্যাক্সেস</string>
    <string name="connection_details_login_label">LOGIN:</string>
    <string name="connection_details_password_label">PASSWORD:</string>
    <string name="connection_details_access_read_write">পড়া/লেখা</string>
    <string name="connection_details_access_read_only">শুধু পড়া</string>
    <string name="connection_details_folder_unspecified">(ফোল্ডার সেট করা নেই)</string>
    <string name="connection_details_cert_title">E. CERTIFICATE WARNING</string>
    <string name="connection_details_cert_body">এই সার্ভার স্ব-স্বাক্ষরিত সার্টিফিকেট ব্যবহার করে। ক্লায়েন্ট সতর্ক করবে।\nক্লায়েন্টের ফিঙ্গারপ্রিন্ট নিচের মানগুলোর সাথে মিলিয়ে দেখুন। মিললে সার্টিফিকেট গ্রহণ করুন।</string>
    <string name="connection_details_cert_sha256_format">SHA-256:  %1$s</string>
    <string name="connection_details_cert_sha1_format">SHA-1:    %1$s</string>
    <string name="connection_details_cert_fingerprint_hint">ক্লায়েন্ট যদি শুধু \"Fingerprint\" দেখায় (অ্যালগরিদমের নাম ছাড়া), আগে SHA-256 তারপর SHA-1-এর সাথে মেলান।</string>
