    <string name="connection_details_access_read_only">ਸਿਰਫ਼ ਪੜ੍ਹਨ</string>
    <string name="connection_details_folder_unspecified">(ਫੋਲਡਰ ਸੈੱਟ ਨਹੀਂ)</string>
    <string name="connection_details_cert_title">E. CERTIFICATE WARNING</string>
    <string name="connection_details_cert_body">ਇਹ ਸਰਵਰ ਸਵੈ-ਦਸਤਖਤੀ ਸਰਟੀਫਿਕੇਟ ਵਰਤਦਾ ਹੈ। ਕਲਾਇੰਟ ਚੇਤਾਵਨੀ ਦੇਵੇਗਾ।\nਕਲਾਇੰਟ ਵਿੱਚ ਫਿੰਗਰਪ੍ਰਿੰਟ ਦੀ ਹੇਠਾਂ ਦਿੱਤੇ ਮੁੱਲਾਂ ਨਾਲ ਤੁਲਨਾ ਕਰੋ। ਮਿਲਣ \'ਤੇ ਸਰਟੀਫਿਕੇਟ ਸਵੀਕਾਰ ਕਰੋ।</string>
    <string name="connection_details_cert_sha256_format">SHA-256:  %1$s</string>
    <string name="connection_details_cert_sha1_format">SHA-1:    %1$s</string>
    <string name="connection_details_cert_fingerprint_hint">ਜੇ ਕਲਾਇੰਟ ਸਿਰਫ਼ \"Fingerprint\" ਦਿਖਾਵੇ (ਐਲਗੋਰਿਦਮ ਨਾਮ ਤੋਂ ਬਿਨਾਂ), ਪਹਿਲਾਂ SHA-256 ਫਿਰ SHA-1 ਨਾਲ ਤੁਲਨਾ ਕਰੋ।</string>
