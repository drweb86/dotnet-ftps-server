    <string name="connection_details_title">Detail koneksi</string>
    <string name="connection_details_intro_android">Untuk terhubung, perangkat klien harus berada di jaringan yang sama dengan ponsel ini (Wi-Fi yang sama, atau hotspot / tethering USB yang sama).</string>
    <string name="connection_details_intro_desktop">Untuk terhubung, perangkat klien harus berada di jaringan yang sama dengan komputer ini (Wi-Fi atau LAN yang sama).</string>
    <string name="connection_details_clients">Pasang klien yang mendukung FTPS, misalnya:\n  • Windows: WinSCP, FileZilla\n  • Linux: FileZilla, lftp\n  • macOS: Cyberduck, FileZilla\n  • Android: Ghost Commander\n  • atau klien lain yang mendukung FTPS eksplisit</string>
    <string name="connection_details_fill_fields">Isi kolom klien sebagai berikut.</string>
    <string name="connection_details_host_title">A. HOST</string>
    <string name="connection_details_host_body">Host adalah alamat perangkat yang menjalankan FTPS Server.\nUtamakan alamat IP. Nama perangkat hanya berfungsi jika jaringan dapat meresolvenya.\n\nGunakan salah satu:</string>
    <string name="connection_details_port_title">B. PORT</string>
    <string name="connection_details_port_body">Port adalah port aplikasi pada host tersebut.</string>
    <string name="connection_details_encryption_title">C. ENCRYPTION</string>
    <string name="connection_details_encryption_body">FTPS Server mengenkripsi perintah dan data.\nHanya TLS EKSPLISIT (AUTH TLS / FTP over TLS) yang didukung.\n\nDi klien, pilih:\n\n  Protocol: FTP\n  Encryption: Explicit TLS\n    (FileZilla: \"Require explicit FTP over TLS\"\n     WinSCP: \"TLS/SSL Explicit encryption\"\n     Cyberduck: \"FTP-SSL (Explicit AUTH TLS)\")\n\nJangan pilih FTPS implisit (sering hanya berlabel \"FTPS\") — tidak akan terhubung.</string>
    <string name="connection_details_accounts_title">D. LOGIN and PASSWORD</string>
    <string name="connection_details_accounts_body">Ini adalah akun yang dapat mengakses folder bersama.</string>
    <string name="connection_details_account_format">%1$s. Pengguna %2$s — akses %3$s ke %4$s</string>
    <string name="connection_details_login_label">LOGIN:</string>
    <string name="connection_details_password_label">PASSWORD:</string>
    <string name="connection_details_access_read_write">baca/tulis</string>
    <string name="connection_details_access_read_only">hanya baca</string>
    <string name="connection_details_folder_unspecified">(folder belum diatur)</string>
    <string name="connection_details_cert_title">E. CERTIFICATE WARNING</string>
    <string name="connection_details_cert_body">Server ini memakai sertifikat self-signed. Klien akan memperingatkan Anda.\nBandingkan sidik jari di klien dengan nilai di bawah. Jika cocok, terima sertifikat.</string>
    <string name="connection_details_cert_sha256_format">SHA-256:  %1$s</string>
    <string name="connection_details_cert_sha1_format">SHA-1:    %1$s</string>
    <string name="connection_details_cert_fingerprint_hint">Jika klien hanya menampilkan \"Fingerprint\" (tanpa nama algoritma), bandingkan dulu dengan SHA-256, lalu SHA-1.</string>
