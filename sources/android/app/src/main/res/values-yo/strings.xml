    <string name="connection_details_title">Àlàyé ìsopọ̀</string>
    <string name="connection_details_intro_android">Láti sopọ̀, ẹ̀rọ oníbàárà gbọ́dọ̀ wà lórí ẹ̀rọ ayélujára kannáà pẹ̀lú foonu yìí (Wi-Fi kannáà, tàbí hotspot / USB tethering kannáà).</string>
    <string name="connection_details_intro_desktop">Láti sopọ̀, ẹ̀rọ oníbàárà gbọ́dọ̀ wà lórí ẹ̀rọ ayélujára kannáà pẹ̀lú kọ̀mpútà yìí (Wi-Fi tàbí LAN kannáà).</string>
    <string name="connection_details_clients">Fi oníbàárà FTPS èyíkéyìí sílẹ̀, fún àpẹẹrẹ:\n  • Windows: WinSCP, FileZilla\n  • Linux: FileZilla, lftp\n  • macOS: Cyberduck, FileZilla\n  • Android: Ghost Commander\n  • tàbí oníbàárà mìíràn tó ṣe atìlẹyìn explicit FTPS</string>
    <string name="connection_details_fill_fields">Kún àwọn pápá oníbàárà báyìí.</string>
    <string name="connection_details_host_title">A. HOST</string>
    <string name="connection_details_host_body">Host ni àdírẹ́sì ẹ̀rọ tí FTPS Server ń ṣiṣẹ́ lórí rẹ̀.\nLo àdírẹ́sì IP. Orúkọ ẹ̀rọ yóò ṣiṣẹ́ nìkan tí ẹ̀rọ ayélujára bá le yanjú rẹ̀.\n\nLo ọ̀kan nínú:</string>
    <string name="connection_details_port_title">B. PORT</string>
    <string name="connection_details_port_body">Port ni èbúté ohun èlò lórí host yẹn.</string>
    <string name="connection_details_encryption_title">C. ENCRYPTION</string>
    <string name="connection_details_encryption_body">FTPS Server ń ṣe ìpamọ́ àṣẹ àti data.\nEXPLICIT TLS (AUTH TLS / FTP over TLS) nìkan ni ó ṣe atìlẹyìn.\n\nNínú oníbàárà, yan:\n\n  Protocol: FTP\n  Encryption: Explicit TLS\n    (FileZilla: \"Require explicit FTP over TLS\"\n     WinSCP: \"TLS/SSL Explicit encryption\"\n     Cyberduck: \"FTP-SSL (Explicit AUTH TLS)\")\n\nMá ṣe yan Implicit FTPS (wọ́n sábà máa ń kọ \"FTPS\" nìkan) — kò ní sopọ̀.</string>
    <string name="connection_details_accounts_title">D. LOGIN and PASSWORD</string>
    <string name="connection_details_accounts_body">Àwọn àkọọ́lẹ̀ tó lè wọ àwọn folda tí a pín.</string>
    <string name="connection_details_account_format">%1$s. Olùmúlò %2$s — ìráyè %3$s sí %4$s</string>
    <string name="connection_details_login_label">LOGIN:</string>
    <string name="connection_details_password_label">PASSWORD:</string>
    <string name="connection_details_access_read_write">kà/kọ</string>
    <string name="connection_details_access_read_only">kà nìkan</string>
    <string name="connection_details_folder_unspecified">(a kò ṣeto folda)</string>
    <string name="connection_details_cert_title">E. CERTIFICATE WARNING</string>
    <string name="connection_details_cert_body">Olùpèsè yìí ń lo ìwé-ẹ̀rí tí ara rẹ̀ fọwọ́ sí. Oníbàárà yóò kìlọ̀.\nFi ìtẹ̀ka ika nínú oníbàárà wé àwọn iye ní ìsàlẹ̀. Tí wọ́n bá jọra, gba ìwé-ẹ̀rí náà.</string>
    <string name="connection_details_cert_sha256_format">SHA-256:  %1$s</string>
    <string name="connection_details_cert_sha1_format">SHA-1:    %1$s</string>
    <string name="connection_details_cert_fingerprint_hint">Tí oníbàárà bá ṣàfihàn \"Fingerprint\" nìkan (láìsí orúkọ algorithm), fi wé SHA-256 kọ́kọ́, lẹ́yìn náà SHA-1.</string>
