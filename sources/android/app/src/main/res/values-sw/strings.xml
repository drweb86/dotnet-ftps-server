    <string name="connection_details_title">Maelezo ya muunganisho</string>
    <string name="connection_details_intro_android">Ili kuunganisha, kifaa cha mteja lazima kiwe kwenye mtandao uleule na simu hii (Wi-Fi ileile, au hotspot / USB tethering ileile).</string>
    <string name="connection_details_intro_desktop">Ili kuunganisha, kifaa cha mteja lazima kiwe kwenye mtandao uleule na kompyuta hii (Wi-Fi au LAN ileile).</string>
    <string name="connection_details_clients">Sakinisha mteja wowote unaotumia FTPS, kwa mfano:\n  • Windows: WinSCP, FileZilla\n  • Linux: FileZilla, lftp\n  • macOS: Cyberduck, FileZilla\n  • Android: Ghost Commander\n  • au mteja mwingine unaounga mkono explicit FTPS</string>
    <string name="connection_details_fill_fields">Jaza sehemu za mteja hivi.</string>
    <string name="connection_details_host_title">A. HOST</string>
    <string name="connection_details_host_body">Host ni anwani ya kifaa kinachoendesha FTPS Server.\nTumia anwani ya IP. Jina la kifaa hufanya kazi tu ikiwa mtandao unaweza kulitambua.\n\nTumia mojawapo:</string>
    <string name="connection_details_port_title">B. PORT</string>
    <string name="connection_details_port_body">Port ni bandari ya programu kwenye host hiyo.</string>
    <string name="connection_details_encryption_title">C. ENCRYPTION</string>
    <string name="connection_details_encryption_body">FTPS Server husimbua amri na data.\nInaauni EXPLICIT TLS pekee (AUTH TLS / FTP over TLS).\n\nKatika mteja, chagua:\n\n  Protocol: FTP\n  Encryption: Explicit TLS\n    (FileZilla: \"Require explicit FTP over TLS\"\n     WinSCP: \"TLS/SSL Explicit encryption\"\n     Cyberduck: \"FTP-SSL (Explicit AUTH TLS)\")\n\nUsichague Implicit FTPS (mara nyingi huandikwa \"FTPS\" tu) — haitaunganisha.</string>
    <string name="connection_details_accounts_title">D. LOGIN and PASSWORD</string>
    <string name="connection_details_accounts_body">Hizi ni akaunti zinazoweza kufikia folda zilizoshirikiwa.</string>
    <string name="connection_details_account_format">%1$s. Mtumiaji %2$s — ufikiaji %3$s kwa %4$s</string>
    <string name="connection_details_login_label">LOGIN:</string>
    <string name="connection_details_password_label">PASSWORD:</string>
    <string name="connection_details_access_read_write">soma/andika</string>
    <string name="connection_details_access_read_only">soma tu</string>
    <string name="connection_details_folder_unspecified">(folda haijawekwa)</string>
    <string name="connection_details_cert_title">E. CERTIFICATE WARNING</string>
    <string name="connection_details_cert_body">Seva hii hutumia cheti kilichojisaini. Mteja atakuonya.\nLinganisha alama ya kidole kwenye mteja na thamani zilizo hapa chini. Zikilingana, kubali cheti.</string>
    <string name="connection_details_cert_sha256_format">SHA-256:  %1$s</string>
    <string name="connection_details_cert_sha1_format">SHA-1:    %1$s</string>
    <string name="connection_details_cert_fingerprint_hint">Ikiwa mteja anaonyesha \"Fingerprint\" tu (bila jina la algorithm), linganisha na SHA-256 kwanza, kisha SHA-1.</string>
    <string name="connection_details_share_subject">Maelezo ya muunganisho wa FTPS Server</string>
