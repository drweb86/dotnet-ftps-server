    <string name="connection_details_title">இணைப்பு விவரங்கள்</string>
    <string name="connection_details_intro_android">இணைய, கிளையன்ட் சாதனம் இந்த தொலைபேசியின் அதே பிணையத்தில் இருக்க வேண்டும் (அதே Wi-Fi, அல்லது அதே ஹாட்ஸ்பாட் / USB டெதரிங்).</string>
    <string name="connection_details_intro_desktop">இணைய, கிளையன்ட் சாதனம் இந்த கணினியின் அதே பிணையத்தில் இருக்க வேண்டும் (அதே Wi-Fi அல்லது LAN).</string>
    <string name="connection_details_clients">FTPS ஆதரவுள்ள எந்த கிளையண்டையும் நிறுவுங்கள், எடுத்துக்காட்டு:\n  • Windows: WinSCP, FileZilla\n  • Linux: FileZilla, lftp\n  • macOS: Cyberduck, FileZilla\n  • Android: Ghost Commander\n  • அல்லது explicit FTPS ஆதரிக்கும் வேறு கிளையண்ட்</string>
    <string name="connection_details_fill_fields">கிளையன்ட் புலங்களை இவ்வாறு நிரப்புங்கள்.</string>
    <string name="connection_details_host_title">A. HOST</string>
    <string name="connection_details_host_body">Host என்பது FTPS Server இயங்கும் சாதனத்தின் முகவரி.\nIP முகவரியை விரும்புங்கள். சாதனப் பெயர் பிணையம் அதைத் தீர்க்க முடிந்தால் மட்டுமே வேலை செய்யும்.\n\nஇவற்றில் ஒன்றைப் பயன்படுத்துங்கள்:</string>
    <string name="connection_details_port_title">B. PORT</string>
    <string name="connection_details_port_body">Port என்பது அந்த ஹோஸ்டில் உள்ள பயன்பாட்டுத் துறை.</string>
    <string name="connection_details_encryption_title">C. ENCRYPTION</string>
    <string name="connection_details_encryption_body">FTPS Server கட்டளைகளையும் தரவையும் மறைகுறியாக்குகிறது.\nEXPLICIT TLS (AUTH TLS / FTP over TLS) மட்டுமே ஆதரிக்கப்படுகிறது.\n\nகிளையண்டில் தேர்ந்தெடுக்கவும்:\n\n  Protocol: FTP\n  Encryption: Explicit TLS\n    (FileZilla: \"Require explicit FTP over TLS\"\n     WinSCP: \"TLS/SSL Explicit encryption\"\n     Cyberduck: \"FTP-SSL (Explicit AUTH TLS)\")\n\nImplicit FTPS தேர்ந்தெடுக்க வேண்டாம் (பெரும்பாலும் \"FTPS\" என்று மட்டும் இருக்கும்) — இணையாது.</string>
    <string name="connection_details_accounts_title">D. LOGIN and PASSWORD</string>
    <string name="connection_details_accounts_body">பகிரப்பட்ட கோப்புறைகளை அணுகக்கூடிய கணக்குகள்.</string>
    <string name="connection_details_account_format">%1$s. பயனர் %2$s — %4$sக்கு %3$s அணுகல்</string>
    <string name="connection_details_login_label">LOGIN:</string>
    <string name="connection_details_password_label">PASSWORD:</string>
    <string name="connection_details_access_read_write">படி/எழுது</string>
    <string name="connection_details_access_read_only">படி மட்டும்</string>
    <string name="connection_details_folder_unspecified">(கோப்புறை அமைக்கப்படவில்லை)</string>
    <string name="connection_details_cert_title">E. CERTIFICATE WARNING</string>
    <string name="connection_details_cert_body">இந்த சேவையகம் சுய கையொப்ப சான்றிதழைப் பயன்படுத்துகிறது. கிளையண்ட் எச்சரிக்கை காட்டும்.\nகிளையண்டில் உள்ள கைரேகையை கீழே உள்ள மதிப்புகளுடன் ஒப்பிடுங்கள். பொருந்தினால் சான்றிதழை ஏற்றுக்கொள்ளுங்கள்.</string>
    <string name="connection_details_cert_sha256_format">SHA-256:  %1$s</string>
    <string name="connection_details_cert_sha1_format">SHA-1:    %1$s</string>
    <string name="connection_details_cert_fingerprint_hint">கிளையண்ட் \"Fingerprint\" மட்டும் காட்டினால் (வழிமுறை பெயர் இல்லாமல்), முதலில் SHA-256 பிறகு SHA-1 உடன் ஒப்பிடுங்கள்.</string>
