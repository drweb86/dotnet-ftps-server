    <string name="connection_details_intro_android">Quunnamuuf meeshaan maamilaa cimdaa bilbila kanaa waliin tokko ta\'uu qaba (Wi-Fi tokko, ykn hotspot / USB tethering tokko).</string>
    <string name="connection_details_intro_desktop">Quunnamuuf meeshaan maamilaa cimdaa kompiitara kanaa waliin tokko ta\'uu qaba (Wi-Fi ykn LAN tokko).</string>
    <string name="connection_details_clients">Maamila FTPS deeggaru kamiyyuu galchi, fakkeenyaaf:\n  • Windows: WinSCP, FileZilla\n  • Linux: FileZilla, lftp\n  • macOS: Cyberduck, FileZilla\n  • Android: Ghost Commander\n  • ykn maamila biraa explicit FTPS deeggaru</string>
    <string name="connection_details_fill_fields">Dirreewwan maamilaa akka armaan gadiitti guuti.</string>
    <string name="connection_details_host_title">A. HOST</string>
    <string name="connection_details_host_body">Host teessoo meeshaa FTPS Server irratti hojjetuudha.\nTeessoo IP filadhu. Maqaan meeshaa cimdaan hiikkachuu yoo danda\'e qofa hojjeta.\n\nTokko kanneen keessaa fayyadami:</string>
    <string name="connection_details_port_title">B. PORT</string>
    <string name="connection_details_port_body">Port keessummeessaa sana irratti balbala app dha.</string>
    <string name="connection_details_encryption_title">C. ENCRYPTION</string>
    <string name="connection_details_encryption_body">FTPS Server ajajaa fi data ni icciti.\nEXPLICIT TLS (AUTH TLS / FTP over TLS) qofa deeggara.\n\nMaamilaa keessatti filadhu:\n\n  Protocol: FTP\n  Encryption: Explicit TLS\n    (FileZilla: \"Require explicit FTP over TLS\"\n     WinSCP: \"TLS/SSL Explicit encryption\"\n     Cyberduck: \"FTP-SSL (Explicit AUTH TLS)\")\n\nImplicit FTPS hin filatin (yeroo baayyee \"FTPS\" qofa jedhama) — hin quunnamu.</string>
    <string name="connection_details_accounts_title">D. LOGIN and PASSWORD</string>
    <string name="connection_details_accounts_body">Akkaawuntiiwwan galmee qoodaman argachuu danda\'an.</string>
    <string name="connection_details_account_format">%1$s. Fayyadamaa %2$s — argannoo %3$s gara %4$s</string>
    <string name="connection_details_login_label">LOGIN:</string>
    <string name="connection_details_password_label">PASSWORD:</string>
    <string name="connection_details_access_read_write">dubbisuu/barreessuu</string>
    <string name="connection_details_access_read_only">dubbisuu qofa</string>
    <string name="connection_details_folder_unspecified">(galmeen hin murteeffamne)</string>
    <string name="connection_details_cert_title">E. CERTIFICATE WARNING</string>
    <string name="connection_details_cert_body">Serveerri kun ragaa ofiin mallatteessame fayyadama. Maamilaan si akeeka.\nAshaaraa qubaa maamilaa gatiiwwan armaan gadii waliin wal bira qabi. Yoo wal simatan ragaa fudhadhu.</string>
    <string name="connection_details_cert_sha256_format">SHA-256:  %1$s</string>
    <string name="connection_details_cert_sha1_format">SHA-1:    %1$s</string>
    <string name="connection_details_cert_fingerprint_hint">Maamilaan \"Fingerprint\" qofa yoo agarsiise (maqaa algorithm malee), duraan SHA-256, itti aansuun SHA-1 waliin wal bira qabi.</string>
