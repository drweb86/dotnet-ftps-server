    <string name="connection_details_title">Connection details</string>
    <string name="connection_details_intro_android">To connect, the client device must be on the same network as this phone (same Wi-Fi, or the same hotspot / USB tethering link).</string>
    <string name="connection_details_intro_desktop">To connect, the client device must be on the same network as this computer (same Wi-Fi or LAN).</string>
    <string name="connection_details_clients">Install any FTPS-capable client, for example:\n  • Windows: WinSCP, FileZilla\n  • Linux: FileZilla, lftp\n  • macOS: Cyberduck, FileZilla\n  • Android: Ghost Commander\n  • or any other client that supports explicit FTPS</string>
    <string name="connection_details_fill_fields">Fill in the client fields as follows.</string>
    <string name="connection_details_host_title">A. HOST</string>
    <string name="connection_details_host_body">Host is the address of the device running FTPS Server.\nPrefer an IP address. The device name works only if your network can resolve it.\n\nUse one of:</string>
    <string name="connection_details_port_title">B. PORT</string>
    <string name="connection_details_port_body">Port is the application port on that host.</string>
    <string name="connection_details_encryption_title">C. ENCRYPTION</string>
    <string name="connection_details_encryption_body">FTPS Server encrypts both commands and data.\nIt supports only EXPLICIT TLS (AUTH TLS / FTP over TLS).\n\nIn the client, choose:\n\n  Protocol: FTP\n  Encryption: Explicit TLS\n    (FileZilla: \"Require explicit FTP over TLS\"\n     WinSCP: \"TLS/SSL Explicit encryption\"\n     Cyberduck: \"FTP-SSL (Explicit AUTH TLS)\")\n\nDo not choose Implicit FTPS (often labeled only \"FTPS\") — it will not connect.</string>
    <string name="connection_details_accounts_title">D. LOGIN and PASSWORD</string>
    <string name="connection_details_accounts_body">These are the accounts that can access shared folders.</string>
    <string name="connection_details_account_format">%1$s. User %2$s — %3$s access to %4$s</string>
    <string name="connection_details_login_label">LOGIN:</string>
    <string name="connection_details_password_label">PASSWORD:</string>
    <string name="connection_details_access_read_write">read/write</string>
    <string name="connection_details_access_read_only">read-only</string>
    <string name="connection_details_folder_unspecified">(folder not set)</string>
    <string name="connection_details_cert_title">E. CERTIFICATE WARNING</string>
    <string name="connection_details_cert_body">This server uses a self-signed certificate. The client will warn you.\nCompare the fingerprint in the client with the values below. If they match, accept the certificate.</string>
    <string name="connection_details_cert_sha256_format">SHA-256:  %1$s</string>
    <string name="connection_details_cert_sha1_format">SHA-1:    %1$s</string>
    <string name="connection_details_cert_fingerprint_hint">If the client shows only \"Fingerprint\" (no algorithm name), compare it to SHA-256 first, then SHA-1.</string>
