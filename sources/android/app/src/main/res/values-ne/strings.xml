    <string name="connection_details_title">जडान विवरण</string>
    <string name="connection_details_intro_android">जडान गर्न क्लाइन्ट यन्त्र यो फोनसँगैको नेटवर्कमा हुनुपर्छ (उही Wi-Fi, वा उही हटस्पट / USB टेथरिङ)।</string>
    <string name="connection_details_intro_desktop">जडान गर्न क्लाइन्ट यन्त्र यो कम्प्युटरसँगैको नेटवर्कमा हुनुपर्छ (उही Wi-Fi वा LAN)।</string>
    <string name="connection_details_clients">कुनै पनि FTPS- सक्षम क्लाइन्ट स्थापना गर्नुहोस्, जस्तै:\n  • Windows: WinSCP, FileZilla\n  • Linux: FileZilla, lftp\n  • macOS: Cyberduck, FileZilla\n  • Android: Ghost Commander\n  • वा explicit FTPS समर्थन गर्ने अन्य क्लाइन्ट</string>
    <string name="connection_details_fill_fields">क्लाइन्टका फिल्ड यसरी भर्नुहोस्।</string>
    <string name="connection_details_host_title">A. HOST</string>
    <string name="connection_details_host_body">Host भनेको FTPS Server चलिरहेको यन्त्रको ठेगाना हो।\nIP ठेगाना प्रयोग गर्नुहोस्। यन्त्रको नाम नेटवर्कले resolve गर्न सके मात्र काम गर्छ।\n\nयी मध्ये एक प्रयोग गर्नुहोस्:</string>
    <string name="connection_details_port_title">B. PORT</string>
    <string name="connection_details_port_body">Port भनेको त्यस होस्टमा अनुप्रयोग पोर्ट हो।</string>
    <string name="connection_details_encryption_title">C. ENCRYPTION</string>
    <string name="connection_details_encryption_body">FTPS Server आदेश र डाटा दुवै इन्क्रिप्ट गर्छ।\nकेवल EXPLICIT TLS (AUTH TLS / FTP over TLS) समर्थित छ।\n\nक्लाइन्टमा छान्नुहोस्:\n\n  Protocol: FTP\n  Encryption: Explicit TLS\n    (FileZilla: \"Require explicit FTP over TLS\"\n     WinSCP: \"TLS/SSL Explicit encryption\"\n     Cyberduck: \"FTP-SSL (Explicit AUTH TLS)\")\n\nImplicit FTPS नछान्नुहोस् (प्रायः केवल \"FTPS\" लेखिएको हुन्छ) — जडान हुँदैन।</string>
    <string name="connection_details_accounts_title">D. LOGIN and PASSWORD</string>
    <string name="connection_details_accounts_body">साझा फोल्डरमा पहुँच गर्न सक्ने खाताहरू।</string>
    <string name="connection_details_account_format">%1$s. प्रयोगकर्ता %2$s — %4$s मा %3$s पहुँच</string>
    <string name="connection_details_login_label">LOGIN:</string>
    <string name="connection_details_password_label">PASSWORD:</string>
    <string name="connection_details_access_read_write">पढ्ने/लेख्ने</string>
    <string name="connection_details_access_read_only">पढ्ने मात्र</string>
    <string name="connection_details_folder_unspecified">(फोल्डर सेट छैन)</string>
    <string name="connection_details_cert_title">E. CERTIFICATE WARNING</string>
    <string name="connection_details_cert_body">यो सर्भर स्वयं-हस्ताक्षरित प्रमाणपत्र प्रयोग गर्छ। क्लाइन्टले चेतावनी देखाउनेछ।\nक्लाइन्टको फिंगरप्रिन्ट तलका मानसँग मिलाउनुहोस्। मिलेमा प्रमाणपत्र स्वीकार गर्नुहोस्।</string>
    <string name="connection_details_cert_sha256_format">SHA-256:  %1$s</string>
    <string name="connection_details_cert_sha1_format">SHA-1:    %1$s</string>
    <string name="connection_details_cert_fingerprint_hint">क्लाइन्टले केवल \"Fingerprint\" देखाएमा (एल्गोरिदम नाम बिना), पहिले SHA-256 त्यसपछि SHA-1 सँग तुलना गर्नुहोस्।</string>
