    <string name="connection_details_title">連線資料</string>
    <string name="connection_details_intro_android">要連線，用戶端裝置必須同呢部手機喺同一網絡（同一個 Wi-Fi，或者同一個熱點 / USB 網絡共享）。</string>
    <string name="connection_details_intro_desktop">要連線，用戶端裝置必須同呢部電腦喺同一網絡（同一個 Wi-Fi 或者區域網絡）。</string>
    <string name="connection_details_clients">安裝任何支援 FTPS 嘅用戶端，例如：\n  • Windows: WinSCP, FileZilla\n  • Linux: FileZilla, lftp\n  • macOS: Cyberduck, FileZilla\n  • Android: Ghost Commander\n  • 或者其他支援顯式 FTPS 嘅用戶端</string>
    <string name="connection_details_fill_fields">請按以下方式填寫用戶端欄位。</string>
    <string name="connection_details_host_title">A. HOST</string>
    <string name="connection_details_host_body">Host 係運行 FTPS Server 嗰部裝置嘅地址。\n建議用 IP 地址。裝置名稱只有網絡可以解析嗰陣先得。\n\n用以下其中一個：</string>
    <string name="connection_details_port_title">B. PORT</string>
    <string name="connection_details_port_body">Port 係嗰個主機上面嘅應用程式埠。</string>
    <string name="connection_details_encryption_title">C. ENCRYPTION</string>
    <string name="connection_details_encryption_body">FTPS Server 會加密指令同數據。\n只支援顯式 TLS（AUTH TLS / FTP over TLS）。\n\n喺用戶端揀：\n\n  Protocol: FTP\n  Encryption: Explicit TLS\n    (FileZilla: \"Require explicit FTP over TLS\"\n     WinSCP: \"TLS/SSL Explicit encryption\"\n     Cyberduck: \"FTP-SSL (Explicit AUTH TLS)\")\n\n唔好揀隱式 FTPS（好多時淨係標「FTPS」）——會連唔到。</string>
    <string name="connection_details_accounts_title">D. LOGIN and PASSWORD</string>
    <string name="connection_details_accounts_body">呢啲帳戶可以存取共用資料夾。</string>
    <string name="connection_details_account_format">%1$s. 用戶 %2$s — 對 %4$s 嘅%3$s權限</string>
    <string name="connection_details_login_label">LOGIN:</string>
    <string name="connection_details_password_label">PASSWORD:</string>
    <string name="connection_details_access_read_write">讀寫</string>
    <string name="connection_details_access_read_only">唯讀</string>
    <string name="connection_details_folder_unspecified">（未設定資料夾）</string>
    <string name="connection_details_cert_title">E. CERTIFICATE WARNING</string>
    <string name="connection_details_cert_body">呢個伺服器使用自行簽署憑證。用戶端會顯示警告。\n將用戶端入面嘅指紋同下面嘅值比較。如果相符，就接受憑證。</string>
    <string name="connection_details_cert_sha256_format">SHA-256:  %1$s</string>
    <string name="connection_details_cert_sha1_format">SHA-1:    %1$s</string>
    <string name="connection_details_cert_fingerprint_hint">如果用戶端淨係顯示「Fingerprint」（冇演算法名稱），先同 SHA-256 比較，再同 SHA-1 比較。</string>
