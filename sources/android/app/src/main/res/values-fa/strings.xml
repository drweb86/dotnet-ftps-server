    <string name="connection_details_title">جزئیات اتصال</string>
    <string name="connection_details_intro_android">برای اتصال، دستگاه کلاینت باید در همان شبکه این گوشی باشد (همان Wi-Fi یا همان هات‌اسپات / USB tethering).</string>
    <string name="connection_details_intro_desktop">برای اتصال، دستگاه کلاینت باید در همان شبکه این رایانه باشد (همان Wi-Fi یا LAN).</string>
    <string name="connection_details_clients">هر کلاینت سازگار با FTPS را نصب کنید، مثلاً:\n  • Windows: WinSCP, FileZilla\n  • Linux: FileZilla, lftp\n  • macOS: Cyberduck, FileZilla\n  • Android: Ghost Commander\n  • یا کلاینت دیگری با FTPS صریح</string>
    <string name="connection_details_fill_fields">فیلدهای کلاینت را این‌گونه پر کنید.</string>
    <string name="connection_details_host_title">A. HOST</string>
    <string name="connection_details_host_body">Host نشانی دستگاهی است که FTPS Server روی آن اجرا می‌شود.\nترجیحاً یک نشانی IP بگذارید. نام دستگاه فقط اگر شبکه بتواند آن را حل کند کار می‌کند.\n\nیکی از این مقادیر را استفاده کنید:</string>
    <string name="connection_details_port_title">B. PORT</string>
    <string name="connection_details_port_body">Port درگاه برنامه روی آن میزبان است.</string>
    <string name="connection_details_encryption_title">C. ENCRYPTION</string>
    <string name="connection_details_encryption_body">FTPS Server فرمان‌ها و داده را رمزنگاری می‌کند.\nفقط TLS صریح (AUTH TLS / FTP over TLS) پشتیبانی می‌شود.\n\nدر کلاینت انتخاب کنید:\n\n  Protocol: FTP\n  Encryption: Explicit TLS\n    (FileZilla: \"Require explicit FTP over TLS\"\n     WinSCP: \"TLS/SSL Explicit encryption\"\n     Cyberduck: \"FTP-SSL (Explicit AUTH TLS)\")\n\nFTPS ضمنی را انتخاب نکنید (اغلب فقط \"FTPS\" نامیده می‌شود) — وصل نمی‌شود.</string>
    <string name="connection_details_accounts_title">D. LOGIN and PASSWORD</string>
    <string name="connection_details_accounts_body">این حساب‌ها به پوشه‌های اشتراکی دسترسی دارند.</string>
    <string name="connection_details_account_format">%1$s. کاربر %2$s — دسترسی %3$s به %4$s</string>
    <string name="connection_details_login_label">LOGIN:</string>
    <string name="connection_details_password_label">PASSWORD:</string>
    <string name="connection_details_access_read_write">خواندن/نوشتن</string>
    <string name="connection_details_access_read_only">فقط خواندنی</string>
    <string name="connection_details_folder_unspecified">(پوشه تنظیم نشده)</string>
    <string name="connection_details_cert_title">E. CERTIFICATE WARNING</string>
    <string name="connection_details_cert_body">این سرور از گواهی خودامضا استفاده می‌کند. کلاینت هشدار می‌دهد.\nاثر انگشت کلاینت را با مقادیر زیر مقایسه کنید. اگر یکی بودند گواهی را بپذیرید.</string>
    <string name="connection_details_cert_sha256_format">SHA-256:  %1$s</string>
    <string name="connection_details_cert_sha1_format">SHA-1:    %1$s</string>
    <string name="connection_details_cert_fingerprint_hint">اگر کلاینت فقط \"Fingerprint\" (بدون نام الگوریتم) نشان داد، ابتدا با SHA-256 سپس SHA-1 مقایسه کنید.</string>
