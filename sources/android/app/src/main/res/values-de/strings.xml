    <string name="connection_details_title">Verbindungsdaten</string>
    <string name="connection_details_intro_android">Zum Verbinden muss das Client-Gerät im selben Netzwerk wie dieses Telefon sein (gleiches WLAN oder derselbe Hotspot / USB-Tethering).</string>
    <string name="connection_details_intro_desktop">Zum Verbinden muss das Client-Gerät im selben Netzwerk wie dieser Computer sein (gleiches WLAN oder LAN).</string>
    <string name="connection_details_clients">Installieren Sie einen FTPS-fähigen Client, zum Beispiel:\n  • Windows: WinSCP, FileZilla\n  • Linux: FileZilla, lftp\n  • macOS: Cyberduck, FileZilla\n  • Android: Ghost Commander\n  • oder einen anderen Client mit explizitem FTPS</string>
    <string name="connection_details_fill_fields">Füllen Sie die Felder im Client wie folgt aus.</string>
    <string name="connection_details_host_title">A. HOST</string>
    <string name="connection_details_host_body">Host ist die Adresse des Geräts, auf dem FTPS Server läuft.\nVerwenden Sie bevorzugt eine IP-Adresse. Der Gerätename funktioniert nur, wenn Ihr Netzwerk ihn auflösen kann.\n\nVerwenden Sie einen der folgenden Werte:</string>
    <string name="connection_details_port_title">B. PORT</string>
    <string name="connection_details_port_body">Port ist der Anwendungsport auf diesem Host.</string>
    <string name="connection_details_encryption_title">C. ENCRYPTION</string>
    <string name="connection_details_encryption_body">FTPS Server verschlüsselt Befehle und Daten.\nUnterstützt wird nur EXPLICIT TLS (AUTH TLS / FTP over TLS).\n\nWählen Sie im Client:\n\n  Protocol: FTP\n  Encryption: Explicit TLS\n    (FileZilla: \"Require explicit FTP over TLS\"\n     WinSCP: \"TLS/SSL Explicit encryption\"\n     Cyberduck: \"FTP-SSL (Explicit AUTH TLS)\")\n\nWählen Sie nicht Implicit FTPS (oft nur als „FTPS“ bezeichnet) — die Verbindung schlägt fehl.</string>
    <string name="connection_details_accounts_title">D. LOGIN and PASSWORD</string>
    <string name="connection_details_accounts_body">Das sind die Konten mit Zugriff auf die freigegebenen Ordner.</string>
    <string name="connection_details_account_format">%1$s. Benutzer %2$s — %3$s Zugriff auf %4$s</string>
    <string name="connection_details_login_label">LOGIN:</string>
    <string name="connection_details_password_label">PASSWORD:</string>
    <string name="connection_details_access_read_write">Lesen/Schreiben</string>
    <string name="connection_details_access_read_only">nur Lesen</string>
    <string name="connection_details_folder_unspecified">(kein Ordner festgelegt)</string>
    <string name="connection_details_cert_title">E. CERTIFICATE WARNING</string>
    <string name="connection_details_cert_body">Dieser Server verwendet ein selbstsigniertes Zertifikat. Der Client zeigt eine Warnung.\nVergleichen Sie den Fingerprint im Client mit den Werten unten. Stimmen sie überein, akzeptieren Sie das Zertifikat.</string>
    <string name="connection_details_cert_sha256_format">SHA-256:  %1$s</string>
    <string name="connection_details_cert_sha1_format">SHA-1:    %1$s</string>
    <string name="connection_details_cert_fingerprint_hint">Wenn der Client nur „Fingerprint“ (ohne Algorithmus) anzeigt, vergleichen Sie zuerst mit SHA-256, dann mit SHA-1.</string>
