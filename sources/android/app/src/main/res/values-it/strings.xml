    <string name="connection_details_title">Dettagli di connessione</string>
    <string name="connection_details_intro_android">Per connettersi, il dispositivo client deve essere sulla stessa rete di questo telefono (stesso Wi-Fi oppure stesso hotspot / tethering USB).</string>
    <string name="connection_details_intro_desktop">Per connettersi, il dispositivo client deve essere sulla stessa rete di questo computer (stesso Wi-Fi o LAN).</string>
    <string name="connection_details_clients">Installare un client compatibile con FTPS, ad esempio:\n  • Windows: WinSCP, FileZilla\n  • Linux: FileZilla, lftp\n  • macOS: Cyberduck, FileZilla\n  • Android: Ghost Commander\n  • o un altro client che supporta FTPS esplicito</string>
    <string name="connection_details_fill_fields">Compilare i campi del client come segue.</string>
    <string name="connection_details_host_title">A. HOST</string>
    <string name="connection_details_host_body">Host è l\'indirizzo del dispositivo su cui è in esecuzione FTPS Server.\nPreferire un indirizzo IP. Il nome del dispositivo funziona solo se la rete può risolverlo.\n\nUsare uno di:</string>
    <string name="connection_details_port_title">B. PORT</string>
    <string name="connection_details_port_body">Port è la porta dell\'applicazione su quell\'host.</string>
    <string name="connection_details_encryption_title">C. ENCRYPTION</string>
    <string name="connection_details_encryption_body">FTPS Server cifra sia i comandi sia i dati.\nSupporta solo TLS ESPLICITO (AUTH TLS / FTP over TLS).\n\nNel client, scegliere:\n\n  Protocol: FTP\n  Encryption: Explicit TLS\n    (FileZilla: \"Require explicit FTP over TLS\"\n     WinSCP: \"TLS/SSL Explicit encryption\"\n     Cyberduck: \"FTP-SSL (Explicit AUTH TLS)\")\n\nNon scegliere FTPS implicito (spesso etichettato solo \"FTPS\") — la connessione non riuscirà.</string>
    <string name="connection_details_accounts_title">D. LOGIN and PASSWORD</string>
    <string name="connection_details_accounts_body">Questi sono gli account che possono accedere alle cartelle condivise.</string>
    <string name="connection_details_account_format">%1$s. Utente %2$s — accesso %3$s a %4$s</string>
    <string name="connection_details_login_label">LOGIN:</string>
    <string name="connection_details_password_label">PASSWORD:</string>
    <string name="connection_details_access_read_write">lettura/scrittura</string>
    <string name="connection_details_access_read_only">sola lettura</string>
    <string name="connection_details_folder_unspecified">(cartella non impostata)</string>
    <string name="connection_details_cert_title">E. CERTIFICATE WARNING</string>
    <string name="connection_details_cert_body">Questo server usa un certificato autofirmato. Il client mostrerà un avviso.\nConfrontare l\'impronta nel client con i valori sotto. Se coincidono, accettare il certificato.</string>
    <string name="connection_details_cert_sha256_format">SHA-256:  %1$s</string>
    <string name="connection_details_cert_sha1_format">SHA-1:    %1$s</string>
    <string name="connection_details_cert_fingerprint_hint">Se il client mostra solo \"Fingerprint\" (senza algoritmo), confrontare prima con SHA-256, poi con SHA-1.</string>
