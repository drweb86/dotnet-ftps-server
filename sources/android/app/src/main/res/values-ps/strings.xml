    <string name="connection_details_access_read_only">یوازې لوستل</string>
    <string name="connection_details_folder_unspecified">(پوښۍ نه ده ټاکل شوې)</string>
    <string name="connection_details_cert_title">E. CERTIFICATE WARNING</string>
    <string name="connection_details_cert_body">دا سرور ځان لاسلیک شوی سند کاروي. پیرودونکی به خبرداری ورکړي.\nپه پیرودونکي کې ګوتې نښه د لاندې ارزښتونو سره پرتله کړئ. که سمون ولري، سند ومنئ.</string>
    <string name="connection_details_cert_sha256_format">SHA-256:  %1$s</string>
    <string name="connection_details_cert_sha1_format">SHA-1:    %1$s</string>
    <string name="connection_details_cert_fingerprint_hint">که پیرودونکی یوازې \"Fingerprint\" وښيي (بې د الګورېتم نوم)، لومړی SHA-256 بیا SHA-1 سره پرتله کړئ.</string>
