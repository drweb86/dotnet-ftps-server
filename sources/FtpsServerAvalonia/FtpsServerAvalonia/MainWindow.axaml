<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:FtpsServerAvalonia.Controls"
        xmlns:res="using:FtpsServerAvalonia.Resources"
        x:Class="FtpsServerAvalonia.MainWindow"
        Title="{x:Static res:Strings.AppTitle}"
        MinWidth="720"
        CanResize="True"
        Background="{StaticResource WindowBackgroundBrush}">

    <Window.Styles>
		<Style Selector="WindowDrawnDecorations /template/ Panel#PART_TitleTextPanel > TextBlock">
			<Setter Property="IsVisible" Value="{Binding !$parent[Window].ExtendClientAreaToDecorationsHint}" />
		</Style>
    </Window.Styles>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<controls:ViewDecoration Grid.Row="0" Grid.RowSpan="2" />

		<StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
			<controls:MainMenuControl x:Name="MainMenu" StartStopClicked="MainMenu_StartStopClicked" />
		</StackPanel>

		<DockPanel Grid.Row="1">
			<controls:UpdateCheckExpanderView DockPanel.Dock="Top" />
			<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
				<StackPanel Classes="FormContent" Spacing="8">
					<controls:MessageBar x:Name="ValidationBar" Kind="Error" />

					<Button x:Name="StartStopButton"
							Classes="SecondaryButton"
							HorizontalAlignment="Stretch"
							HorizontalContentAlignment="Center"
							VerticalContentAlignment="Center"
							MinHeight="48"
							Click="MainMenu_StartStopClicked">
						<TextBlock x:Name="StartStopButtonText"
								   Text="{x:Static res:Strings.MenuStart}"
								   Foreground="Green"
								   FontWeight="Bold"
								   VerticalAlignment="Center"/>
					</Button>

					<Expander x:Name="ConnectionInstructionExpander"
							  Classes="SectionExpander ConnectionInstruction"
							  IsExpanded="True"
							  IsVisible="False">
						<Expander.Header>
							<controls:ExpanderHeader Icon="📋" Text="{x:Static res:Strings.ConnectionInstructionTitle}" />
						</Expander.Header>
						<controls:ConnectionInstructionControl x:Name="ConnectionInstruction" />
					</Expander>

					<Expander x:Name="ConfigExpander" Classes="SectionExpander" IsExpanded="True">
						<Expander.Header>
							<controls:ExpanderHeader Icon="🔒" Text="{x:Static res:Strings.ConfigTitle}" />
						</Expander.Header>
						<controls:ServerConfigurationControl
							x:Name="ServerConfig"
							Port="{Binding Port, Mode=TwoWay}"
							MaxConnections="{Binding MaxConnections, Mode=TwoWay}"
							CertificateSource="{Binding CertificateSource, Mode=TwoWay}"
							CertificatePath="{Binding CertificatePath, Mode=TwoWay}"
							CertificatePassword="{Binding CertificatePassword, Mode=TwoWay}" />
					</Expander>

					<Expander x:Name="UsersExpander" Classes="SectionExpander" IsExpanded="True">
						<Expander.Header>
							<controls:ExpanderHeader Icon="👨" Text="{x:Static res:Strings.UsersTab}" />
						</Expander.Header>
						<StackPanel>
							<Button Content="{x:Static res:Strings.AddUserButton}"
									Classes="SecondaryButton"
									HorizontalAlignment="Left"
									Click="AddUser_Click"
									Margin="0,8,0,8"
									Padding="16,8"/>
							<ItemsControl x:Name="UsersItemsControl">
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<controls:UserItemControl RemoveUserRequested="UserItemControl_RemoveUserRequested"/>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</StackPanel>
					</Expander>

					<Expander x:Name="LogsExpander" Classes="SectionExpander" IsExpanded="True" IsVisible="False">
						<Expander.Header>
							<controls:ExpanderHeader Icon="📜" Text="{x:Static res:Strings.LogsTab}" />
						</Expander.Header>
						<StackPanel>
							<Button Content="{x:Static res:Strings.ClearLogs}"
									Classes="SecondaryButton"
									HorizontalAlignment="Left"
									Click="ClearLogs_Click"
									Margin="0,8,0,8"
									Padding="16,8"/>
							<Border Background="{StaticResource WindowBackgroundBrush}"
									CornerRadius="4"
									Padding="8"
									MinHeight="200"
									MaxHeight="400">
								<ScrollViewer x:Name="LogScrollViewer"
											  VerticalScrollBarVisibility="Auto"
											  HorizontalScrollBarVisibility="Disabled">
									<ItemsControl x:Name="LogItemsControl">
										<ItemsControl.ItemTemplate>
											<DataTemplate>
												<TextBlock Text="{Binding FormattedMessage}"
														   Foreground="{Binding Color}"
														   TextWrapping="Wrap"
														   Margin="0,2"/>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
								</ScrollViewer>
							</Border>
						</StackPanel>
					</Expander>
				</StackPanel>
			</ScrollViewer>
		</DockPanel>
	</Grid>
</Window>
