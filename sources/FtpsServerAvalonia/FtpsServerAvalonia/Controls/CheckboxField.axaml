<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:FtpsServerAvalonia.Controls"
             x:Class="FtpsServerAvalonia.Controls.CheckboxField"
             x:Name="Root"
             Margin="0 8 0 8">
	<StackPanel>
		<CheckBox IsChecked="{Binding #Root.IsChecked, Mode=TwoWay}"
				  Classes="ModernCheckBox"
				  Content="{Binding #Root.Label}" />
		<TextBlock Margin="0 8 0 0"
				IsVisible="{Binding #Root.Help, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
				Text="{Binding #Root.Help}"
				Classes="ModernLabel"
				TextWrapping="Wrap" />
		<controls:ValidationError Error="{Binding #Root.Error}" />
	</StackPanel>
</UserControl>
