<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:FtpsServerAvalonia.Controls"
             x:Class="FtpsServerAvalonia.Controls.TextFieldWithAction"
             x:Name="Root"
             Margin="0 8 0 8">
	<StackPanel>
		<TextBlock Text="{Binding #Root.Label}" Classes="ModernLabel" Margin="0 0 0 8" />
		<Grid ColumnDefinitions="*,Auto">
			<TextBox Grid.Column="0"
					 Classes="ModernTextBox"
					 VerticalAlignment="Center"
					 Margin="0 0 8 0"
					 IsReadOnly="{Binding #Root.IsReadOnly}"
					 PlaceholderText="{Binding #Root.Placeholder}"
					 Text="{Binding #Root.Text, Mode=TwoWay}" />
			<Button Grid.Column="1"
					Classes="SecondaryButton"
					VerticalAlignment="Center"
					Content="{Binding #Root.ActionText}"
					Click="ActionButton_Click" />
		</Grid>
		<TextBlock Margin="0 8 0 0"
				IsVisible="{Binding #Root.Help, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
				Text="{Binding #Root.Help}"
				Classes="ModernLabel"
				TextWrapping="Wrap" />
		<controls:ValidationError Error="{Binding #Root.Error}" />
	</StackPanel>
</UserControl>
