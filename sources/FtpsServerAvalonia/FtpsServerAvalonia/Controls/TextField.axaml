<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:FtpsServerAvalonia.Controls"
             x:Class="FtpsServerAvalonia.Controls.TextField"
             x:Name="Root"
             Margin="0 8 0 8">
	<StackPanel>
		<TextBlock Margin="0 0 0 8"
				   Classes="ModernLabel"
				   Text="{Binding #Root.Label}" />
		<Grid ColumnDefinitions="*,Auto">
			<TextBox x:Name="Input"
					 Grid.Column="0"
					 Text="{Binding #Root.Text, Mode=TwoWay}"
					 Classes="ModernTextBox"
					 VerticalAlignment="Center"
					 PlaceholderText="{Binding #Root.Placeholder}"
					 PasswordChar="{Binding #Root.PasswordChar}" />
			<Button x:Name="Reveal"
					Grid.Column="1"
					Margin="8 0 0 0"
					Classes="SecondaryButton"
					VerticalAlignment="Center"
					Content="{Binding #Root.RevealText}"
					IsVisible="{Binding #Root.IsPassword}"
					Click="Reveal_Click" />
		</Grid>
		<TextBlock Margin="0 8 0 0"
				IsVisible="{Binding #Root.Help, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
				Text="{Binding #Root.Help}"
				Classes="ModernLabel"
				TextWrapping="Wrap" />
		<controls:ValidationError Error="{Binding #Root.Error}" />
	</StackPanel>
</UserControl>
