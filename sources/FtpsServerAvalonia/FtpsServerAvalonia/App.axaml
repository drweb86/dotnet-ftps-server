<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FtpsServerAvalonia.App"
             RequestedThemeVariant="Dark">

    <Application.Styles>
        <FluentTheme />
		<StyleInclude Source="avares://FtpsServerAvalonia/Themes/TaskSectionExpander.axaml" />
		<StyleInclude Source="avares://FtpsServerAvalonia/Themes/FormContent.axaml" />

        <Style>
            <Style.Resources>
                <!-- Surfaces match BUtil dark window / section colors (#28272C / #2B2A31). -->
                <Color x:Key="PrimaryDark">#1C1B20</Color>
                <Color x:Key="SecondaryDark">#2B2A31</Color>
                <Color x:Key="TertiaryDark">#35343C</Color>
                <Color x:Key="AccentCyan">#00D9FF</Color>
                <Color x:Key="AccentCyanHover">#33E1FF</Color>
                <Color x:Key="AccentBlue">#0078D4</Color>
                <Color x:Key="Success">#10B981</Color>
                <Color x:Key="Warning">#F59E0B</Color>
                <Color x:Key="Error">#EF4444</Color>
                <Color x:Key="BorderColor">#45444D</Color>
                <Color x:Key="WindowBackground">#28272C</Color>

                <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDark}"/>
                <SolidColorBrush x:Key="SecondaryDarkBrush" Color="{StaticResource SecondaryDark}"/>
                <SolidColorBrush x:Key="TertiaryDarkBrush" Color="{StaticResource TertiaryDark}"/>
                <SolidColorBrush x:Key="AccentCyanBrush" Color="{StaticResource AccentCyan}"/>
                <SolidColorBrush x:Key="AccentCyanHoverBrush" Color="{StaticResource AccentCyanHover}"/>
                <SolidColorBrush x:Key="AccentBlueBrush" Color="{StaticResource AccentBlue}"/>
                <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Success}"/>
                <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource Warning}"/>
                <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource Error}"/>
                <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
                <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackground}"/>
            </Style.Resources>
        </Style>

        <Style Selector="Window">
            <Setter Property="Background" Value="{StaticResource WindowBackgroundBrush}"/>
        </Style>

        <Style Selector="Button.ModernButton">
            <Setter Property="Background" Value="{StaticResource AccentCyanBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryDarkBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <Style Selector="Button.ModernButton:pointerover">
            <Setter Property="Background" Value="{StaticResource AccentCyanHoverBrush}"/>
        </Style>
        <Style Selector="Button.ModernButton:disabled">
            <Setter Property="Opacity" Value="0.5"/>
        </Style>

        <Style Selector="Button.SecondaryButton">
            <Setter Property="Background" Value="{StaticResource TertiaryDarkBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.SecondaryButton:pointerover">
            <Setter Property="Background" Value="{StaticResource SecondaryDarkBrush}"/>
        </Style>

        <Style Selector="TextBox.ModernTextBox">
            <Setter Property="Background" Value="{StaticResource SecondaryDarkBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="TextBox.ModernTextBox:focus">
            <Setter Property="BorderBrush" Value="{StaticResource AccentCyanBrush}"/>
        </Style>

        <Style Selector="CheckBox.ModernCheckBox">
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="ComboBox.ModernComboBox">
            <Setter Property="Background" Value="{StaticResource SecondaryDarkBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>

        <Style Selector="TextBlock.ModernLabel">
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>

        <Style Selector="TextBlock.Title">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style Selector="Border.Card">
            <Setter Property="Background" Value="{StaticResource SecondaryDarkBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="24"/>
        </Style>
    </Application.Styles>
</Application>
